---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { getSession } from "../lib/auth";
import { parse } from "cookie";
import { getClockifyUser, getDailyDTR } from "../lib/clockify";
import { getAppSettings } from "../lib/settings";
import { getManualEntries, getActiveTimer } from "../lib/entries";
import { supabase } from "../lib/supabase";
import { getMonthlyAttendance } from "../lib/attendance";

const cookieHeader = Astro.request.headers.get("cookie") || "";
const cookies = parse(cookieHeader);
const user = cookies.session ? await getSession(cookies.session) : null;

if (!user) return Astro.redirect("/");

const mySettings = await getAppSettings(user.id);
const targetStudentId = Astro.url.searchParams.get("studentId");
let viewUserId = user.id;

// Coordinator Logic (view-only) — same resolution pattern as dtr.astro
let students = [];
let sections = [];
let filteredStudents = [];
const selectedSection = Astro.url.searchParams.get("section") || "all";

if (mySettings.role === "coordinator") {
  const { data: mySections } = await supabase
    .from("coordinator_sections")
    .select("*")
    .eq("coordinator_id", user.id)
    .order("section_name", { ascending: true });
  sections = mySections || [];

  const { data: myStudents } = await supabase
    .from("student_settings")
    .select("user_id, user_name, section_id")
    .eq("coordinator_id", user.id);
  students = myStudents || [];

  filteredStudents = students;
  if (selectedSection !== "all") {
    filteredStudents = students.filter(s => s.section_id === selectedSection);
  }

  if (targetStudentId && students.some((s) => s.user_id === targetStudentId)) {
    const isStudentInFiltered = selectedSection === 'all' ||
      (students.find(s => s.user_id === targetStudentId)?.section_id === selectedSection);

    if (isStudentInFiltered) {
      viewUserId = targetStudentId;
    } else if (filteredStudents.length > 0) {
      viewUserId = filteredStudents[0].user_id;
    }
  } else if (filteredStudents.length > 0) {
    viewUserId = filteredStudents[0].user_id;
  }
}

const isReadOnly = mySettings.role === "coordinator";
const settings = await getAppSettings(viewUserId);

// Coordinators can inspect either partition for a student; self-view always shows the viewer's own current mode.
const modeParam = Astro.url.searchParams.get("mode");
const viewIsEmployee = isReadOnly && modeParam
  ? modeParam === "employee"
  : (settings.isEmployee ?? false);

const isEditable = !isReadOnly;

const now = new Date();
const currentMonth = now.getMonth() + 1;
const currentYear = now.getFullYear();

const month = parseInt(Astro.url.searchParams.get("month") || currentMonth.toString());
const year = parseInt(Astro.url.searchParams.get("year") || currentYear.toString());

const isClockifySet = !!(
  import.meta.env.CLOCKIFY_API_KEY && import.meta.env.CLOCKIFY_WORKSPACE_ID
);

const manual = await getManualEntries(viewUserId, viewIsEmployee);
const manualFiltered = manual.filter((e) => {
  const d = new Date(e.startFull || `${e.date}T${e.startTime}+08:00`);
  return d.getMonth() + 1 === month && d.getFullYear() === year;
});

let clockifyId = "";
if (isClockifySet && settings.clockifyEnabled !== false) {
  try {
    const clockifyUser = await getClockifyUser(settings.userEmail || "");
    if (clockifyUser) clockifyId = clockifyUser.id;
  } catch (e) {}
}

const dtrResult = await getDailyDTR(clockifyId, month, year, manualFiltered);
const dailyTotals: Record<number, number> = {};
for (const d of dtrResult.days) dailyTotals[parseInt(d.day)] = d.totalSeconds;

// A running (not yet clocked out) timer has no `end`, so getDailyDTR never counts it into
// dailyTotals — without this, today's cell sits blank while the intern is actively clocked in.
const activeTimer = await getActiveTimer(viewUserId, viewIsEmployee);
const ongoingDate = activeTimer
  ? new Date(activeTimer.startTime).toLocaleDateString("en-CA", { timeZone: "Asia/Manila" })
  : null;

const { days, config, holidays } = await getMonthlyAttendance(viewUserId, viewIsEmployee, month, year, dailyTotals, ongoingDate);

const todayStr = new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Manila" });

const monthName = new Date(year, month - 1)
  .toLocaleDateString("en-US", { month: "long", timeZone: "Asia/Manila" })
  .toUpperCase();

const leadingBlanks = new Date(year, month - 1, 1).getDay();
const weekdayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

const STATUS_LABELS: Record<string, string> = {
  present: 'Present', absent: 'Absent', wfh: 'WFH', sl: 'Sick Leave', vl: 'Vacation Leave',
};
const shortMonth = new Date(year, month - 1).toLocaleDateString('en-US', { month: 'short' });

// Consecutive days sharing a status and reason are one absence, not five separate rows — so a
// three-day sick leave reads as "Sep 3–5" instead of repeating the same line three times.
const reasonSpans: { from: number; to: number; status: string; reason: string; days: number }[] = [];
for (const d of days) {
  if (!d.reason) continue;
  const last = reasonSpans[reasonSpans.length - 1];
  if (last && last.status === d.status && last.reason === d.reason && d.day === last.to + 1) {
    last.to = d.day;
    last.days++;
  } else {
    reasonSpans.push({ from: d.day, to: d.day, status: d.status, reason: d.reason, days: 1 });
  }
}
---

<Layout title="Attendance Chart">
  <Header user={user} />

  <div id="portal-body">
    <Sidebar user={user} activeTab="attendance" role={mySettings.role} />

    <main id="portal-main">
      <div class="bg-grid" aria-hidden="true"></div>

      <div class="page-header">
        <h1>Attendance</h1>
        <p class="page-subtitle">
          {settings.isEmployee ? "Employee" : "OJT"} attendance for {monthName} {year}
          {isReadOnly && <span class="readonly-pill">View only</span>}
        </p>
      </div>

      <div class="actions-bar">
        <div class="month-selector">
          {
            mySettings.role === "coordinator" && (
              <>
                <select id="section-selector" class="att-select">
                  <option value="all" selected={selectedSection === 'all'}>All Sections</option>
                  {sections.map((sec) => (
                    <option value={sec.id} selected={sec.id === selectedSection}>
                      {sec.section_name}
                    </option>
                  ))}
                </select>

                <select id="student-selector" class="att-select" disabled={filteredStudents.length === 0}>
                  {filteredStudents.length > 0 ? (
                    filteredStudents.map((s) => (
                      <option value={s.user_id} selected={s.user_id === viewUserId}>
                        {s.user_name}
                      </option>
                    ))
                  ) : (
                    <option value="">No students in section</option>
                  )}
                </select>

                <select id="mode-selector" class="att-select">
                  <option value="ojt" selected={!viewIsEmployee}>OJT Mode</option>
                  <option value="employee" selected={viewIsEmployee}>Employee Mode</option>
                </select>
              </>
            )
          }
          <select id="month-selector" class="att-select">
            {
              Array.from({ length: 12 }).map((_, i) => (
                <option value={i + 1} selected={month === i + 1}>
                  {new Date(0, i).toLocaleString("en-US", { month: "long" })}
                </option>
              ))
            }
          </select>
          <select id="year-selector" class="att-select">
            {
              [2024, 2025, 2026].map((y) => (
                <option value={y} selected={year === y}>{y}</option>
              ))
            }
          </select>
        </div>

        {isEditable && (
          <button id="config-btn" class="config-btn" title="Configure calendar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" stroke="currentColor" stroke-width="1.7"/></svg>
            Configure Calendar
          </button>
        )}
      </div>

      <div class="legend">
        <span class="legend-item"><i class="swatch present"></i>Present</span>
        <span class="legend-item"><i class="swatch absent"></i>Absent</span>
        <span class="legend-item"><i class="swatch wfh"></i>WFH</span>
        <span class="legend-item"><i class="swatch sl"></i>Sick Leave</span>
        <span class="legend-item"><i class="swatch vl"></i>Vacation Leave</span>
        <span class="legend-item"><i class="swatch non-working"></i>Non-working</span>
        <span class="legend-item"><i class="swatch ongoing"></i>Ongoing</span>
      </div>

      <div class="calendar-wrapper">
        <div class="calendar-grid" id="calendar-grid">
          {weekdayLabels.map((w) => <div class="weekday-header">{w}</div>)}
          {Array.from({ length: leadingBlanks }).map(() => <div class="day-cell blank"></div>)}
          {days.map((d) => (
            <div
              class={`day-cell status-${d.status} ${d.isHalfDay ? 'half-day' : ''} ${d.isUndertime ? 'undertime' : ''} ${d.isOngoing ? 'ongoing' : ''} ${isEditable ? 'editable' : (d.date <= todayStr ? 'viewable' : '')}`}
              data-day={d.day}
              data-date={d.date}
              data-status={d.status}
              data-half={d.isHalfDay ? '1' : '0'}
              data-reason={d.reason || ''}
              title={d.reason || undefined}
            >
              <span class="day-num">{d.day}</span>
              {d.reason && <span class="cell-reason">{d.reason}</span>}
              {d.isHoliday && <span class="holiday-dot" title={d.holidayLabel || 'Holiday'}></span>}
              {d.isUndertime && <span class="undertime-badge" title="Undertime">UT</span>}
              {d.totalSeconds > 0 && <span class="day-hours">{(d.totalSeconds / 3600).toFixed(1)}h</span>}
            </div>
          ))}
        </div>

        {reasonSpans.length > 0 && (
          <section class="reason-summary">
            <h2 class="reason-summary-title">Why these days were marked</h2>
            <ul class="reason-list">
              {reasonSpans.map(span => (
                <li class="reason-item">
                  <i class={`swatch ${span.status}`}></i>
                  <span class="reason-dates">
                    {shortMonth} {span.from}{span.to !== span.from ? `–${span.to}` : ''}
                    {span.days > 1 && <span class="reason-daycount">{span.days} days</span>}
                  </span>
                  <span class="reason-status">{STATUS_LABELS[span.status] || span.status}</span>
                  <span class="reason-text">{span.reason}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </main>
  </div>

  {isEditable && (
    <div id="status-popover" class="status-popover hidden">
      <div class="popover-header">
        <div class="popover-date" id="popover-date"></div>
        <button type="button" id="popover-dismiss" class="popover-dismiss-btn" aria-label="Close">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="popover-logs" class="popover-logs"></div>
      <div id="popover-edit-section">
        <label class="range-toggle">
          <input type="checkbox" id="popover-range-toggle" />
          Apply to a date range
        </label>
        <div id="popover-range-fields" class="popover-range-fields hidden">
          <span class="range-label">through</span>
          <input type="date" id="popover-end-date" />
        </div>
        <label class="half-day-toggle">
          <input type="checkbox" id="popover-half-day" />
          Half day
        </label>
        <div class="popover-reason">
          <label class="reason-label" for="popover-reason">Reason <span>(optional)</span></label>
          <input type="text" id="popover-reason" maxlength="200" placeholder="e.g. Fever, family emergency, WFH — no transport" />
        </div>
        <div class="popover-buttons-label">Tap a status to apply it:</div>
        <div class="popover-buttons">
          <button class="status-btn present" data-status="present"><span class="btn-label">Present</span></button>
          <button class="status-btn absent" data-status="absent"><span class="btn-label">Absent</span></button>
          <button class="status-btn wfh" data-status="wfh"><span class="btn-label">WFH</span></button>
          <button class="status-btn sl" data-status="sl" title="Sick Leave"><span class="btn-label">SL</span></button>
          <button class="status-btn vl full-width" data-status="vl" title="Vacation Leave"><span class="btn-label">VL</span></button>
        </div>
        <div class="popover-footer">
          <button id="popover-clear" class="popover-clear-btn"><span class="btn-label">Clear</span></button>
          <button id="popover-close" class="popover-close-btn">Cancel</button>
        </div>
      </div>
    </div>
  )}

  {isEditable && (
    <div id="config-modal" class="modal-overlay">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Configure Calendar</h2>
          <button id="config-close" class="modal-close-btn" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <div class="modal-section">
          <label class="modal-label">Non-working days</label>
          <div class="weekday-checks">
            {weekdayLabels.map((w, i) => (
              <label class="weekday-check">
                <input type="checkbox" class="nonworking-check" value={i} checked={config.nonWorkingWeekdays.includes(i)} />
                {w}
              </label>
            ))}
          </div>
        </div>

        <div class="modal-section">
          <label class="modal-label" for="full-day-hours">Standard full-day hours</label>
          <input type="number" id="full-day-hours" min="0.5" step="0.5" value={config.fullDayHours} />
          <p class="modal-hint">Reference value for your normal workday length. Half-day (&lt;5h) and undertime (5–6h) detection always uses these fixed thresholds regardless of this setting.</p>
        </div>

        <div class="modal-section">
          <label class="modal-label">Holidays</label>
          <div id="holiday-list" class="holiday-list">
            {holidays.map((h) => (
              <div class="holiday-row" data-id={h.id}>
                <span class="holiday-date">{h.date}</span>
                <span class="holiday-label">{h.label}</span>
                <button class="holiday-remove-btn" data-id={h.id}><span class="btn-label">&times;</span></button>
              </div>
            ))}
          </div>
          <div class="holiday-add-row">
            <input type="date" id="holiday-date-input" />
            <input type="text" id="holiday-label-input" placeholder="Label (e.g. Independence Day)" />
            <button id="holiday-add-btn" class="holiday-add-btn"><span class="btn-label">Add</span></button>
          </div>
        </div>

        <div class="modal-actions">
          <button id="config-save-btn" class="save-btn"><span class="btn-label">Save Configuration</span></button>
        </div>
      </div>
    </div>
  )}

  <div id="day-details-modal" class="modal-overlay">
    <div class="modal-content day-details-content">
      <div class="modal-header">
        <h2 id="day-details-title">Time logs</h2>
        <button id="day-details-close" class="modal-close-btn" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="day-details-body" class="day-details-body"></div>
    </div>
  </div>
</Layout>

<script define:vars={{ isEditable }}>
  const secSel = document.getElementById("section-selector");
  const sSel = document.getElementById("student-selector");
  const modeSel = document.getElementById("mode-selector");
  const mSel = document.getElementById("month-selector");
  const ySel = document.getElementById("year-selector");

  const buildUrl = (e) => {
    let url = `/attendance?month=${mSel.value}&year=${ySel.value}`;
    if (secSel?.value) url += `&section=${secSel.value}`;
    if (e?.target !== secSel && sSel?.value) url += `&studentId=${sSel.value}`;
    if (modeSel?.value) url += `&mode=${modeSel.value}`;
    return url;
  };
  const update = (e) => { window.location.href = buildUrl(e); };

  // Switching month/year swaps just the calendar in place instead of reloading the whole page.
  // The grid element itself stays (its click handlers live on it); only its cells are replaced.
  const loadMonth = async (e) => {
    const url = buildUrl(e);
    const grid = document.getElementById("calendar-grid");
    const wrapper = document.querySelector(".calendar-wrapper");
    // Selects stay locked until the new month lands, so two switches can't race each other.
    mSel.disabled = ySel.disabled = true;
    const hideLoader = window.showSectionLoading?.(
      wrapper,
      `Loading ${mSel.options[mSel.selectedIndex].text} ${ySel.value}`
    );
    try {
      const res = await fetch(url);
      if (!res.ok || res.redirected) throw new Error("fallback");
      const doc = new DOMParser().parseFromString(await res.text(), "text/html");
      const freshGrid = doc.getElementById("calendar-grid");
      if (!grid || !wrapper || !freshGrid) throw new Error("fallback");
      grid.replaceChildren(...freshGrid.childNodes);
      wrapper.querySelector(".reason-summary")?.remove();
      const freshReasons = doc.querySelector(".calendar-wrapper .reason-summary");
      if (freshReasons) wrapper.append(freshReasons);
      const subtitle = document.querySelector(".page-subtitle");
      const freshSubtitle = doc.querySelector(".page-subtitle");
      if (subtitle && freshSubtitle) subtitle.replaceChildren(...freshSubtitle.childNodes);
      history.replaceState(null, "", url);
    } catch {
      window.location.href = url;
      return; // leave the loader up while the full page load takes over
    }
    hideLoader?.();
    mSel.disabled = ySel.disabled = false;
  };

  secSel?.addEventListener("change", update);
  sSel?.addEventListener("change", update);
  modeSel?.addEventListener("change", update);
  mSel?.addEventListener("change", loadMonth);
  ySel?.addEventListener("change", loadMonth);

  // That day's actual time-tracker sessions (manual + Clockify) — shown automatically, no extra
  // click: as a modal for the read-only coordinator view, inline in the popover for the editable one.
  const pageParams = new URLSearchParams(window.location.search);

  const formatClock = (t) => {
    if (!t) return "--";
    const [h, m] = t.split(":");
    const hour = parseInt(h, 10);
    const ampm = hour >= 12 ? "PM" : "AM";
    const h12 = hour % 12 === 0 ? 12 : hour % 12;
    return `${h12}:${m} ${ampm}`;
  };
  const formatDuration = (seconds) => {
    const h = Math.floor(seconds / 3600);
    const m = Math.round((seconds % 3600) / 60);
    return h > 0 ? `${h}h ${m}m` : `${m}m`;
  };
  const escapeHtml = (s) => (s || "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const timeToSeconds = (t) => {
    if (!t) return 0;
    const [h, m, s] = t.split(":").map(Number);
    return h * 3600 + (m || 0) * 60 + (s || 0);
  };

  // Same gap-between-sessions "Break" divider as the Time Tracker tab: entries here are already
  // chronological (earliest first), so a divider goes right after any entry that isn't immediately
  // followed by the next one.
  const logsHtml = (data) => {
    if (!data.items.length) return '<div class="day-details-empty">No time logged for this day.</div>';
    const mixedSources = data.items.some((i) => i.source === "clockify");
    const rows = data.items.map((item, idx) => {
      const badge = mixedSources ? `<span class="log-source-badge ${item.source}">${item.source === "clockify" ? "Clockify" : "Manual"}</span>` : "";
      const entry = `
        <li class="log-entry">
          <div class="log-entry-info">
            <div class="log-entry-title-row">
              <span class="log-entry-desc">${escapeHtml(item.description)}</span>${badge}
            </div>
            <span class="log-entry-time">${formatClock(item.startTime)} — ${formatClock(item.endTime)}</span>
          </div>
          <span class="log-entry-duration">${formatDuration(item.durationSeconds)}</span>
        </li>
      `;
      const next = data.items[idx + 1];
      if (!next) return entry;
      const gapMin = Math.round((timeToSeconds(next.startTime) - timeToSeconds(item.endTime)) / 60);
      if (gapMin <= 0) return entry;
      return `${entry}
        <li class="log-break-divider">
          <span class="log-break-line"></span>
          <span class="log-break-label">Break — ${formatDuration(gapMin * 60)}</span>
          <span class="log-break-line"></span>
        </li>
      `;
    }).join("");
    return `
      <div class="day-logs-card">
        <ul class="day-logs-list">${rows}</ul>
        <div class="day-logs-total"><span>Total logged</span><span>${formatDuration(data.totalSeconds)}</span></div>
      </div>
    `;
  };

  // Fetches and renders `date`'s logs into `container`, tagging each request so a slow one that
  // resolves after the user has already moved to another day doesn't overwrite what's shown now.
  // `onData` (optional) gets the parsed response once loaded, so callers can react to whether the
  // day actually has real logged sessions — e.g. hiding the status-editing controls when it does.
  let logsRequestToken = 0;
  async function loadLogsInto(container, date, onData) {
    if (!container) return;
    const myToken = ++logsRequestToken;
    container.innerHTML = '<div class="day-details-loading">Loading time logs…</div>';

    const url = new URL("/api/attendance/day-entries", window.location.origin);
    url.searchParams.set("date", date);
    if (pageParams.get("studentId")) url.searchParams.set("studentId", pageParams.get("studentId"));
    if (pageParams.get("mode")) url.searchParams.set("mode", pageParams.get("mode"));

    try {
      const res = await fetch(url);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to load time logs");
      if (logsRequestToken !== myToken) return;
      container.innerHTML = logsHtml(data);
      onData?.(data);
    } catch (err) {
      if (logsRequestToken !== myToken) return;
      container.innerHTML = `<div class="day-details-empty">${err.message || "Error loading time logs"}</div>`;
      onData?.(null);
    }
  }

  if (!isEditable) {
    const detailsModal = document.getElementById("day-details-modal");
    const detailsTitle = document.getElementById("day-details-title");
    const detailsBody = document.getElementById("day-details-body");

    const closeDayDetails = () => detailsModal?.classList.remove("active");
    document.getElementById("day-details-close")?.addEventListener("click", closeDayDetails);
    detailsModal?.addEventListener("click", (e) => { if (e.target === detailsModal) closeDayDetails(); });

    document.getElementById("calendar-grid")?.addEventListener("click", (e) => {
      const cell = e.target.closest(".day-cell.viewable");
      if (!cell) return;
      detailsModal.classList.add("active");
      detailsTitle.textContent = new Date(`${cell.dataset.date}T00:00:00`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
      loadLogsInto(detailsBody, cell.dataset.date);
    });
  } else {
    const popover = document.getElementById("status-popover");
    const popoverDate = document.getElementById("popover-date");
    const halfDayCheckbox = document.getElementById("popover-half-day");
    const rangeToggle = document.getElementById("popover-range-toggle");
    const rangeFields = document.getElementById("popover-range-fields");
    const endDateInput = document.getElementById("popover-end-date");
    const reasonInput = document.getElementById("popover-reason");
    const popoverLogs = document.getElementById("popover-logs");
    const popoverEditSection = document.getElementById("popover-edit-section");
    let activeCell = null;
    // Bumped every time a save starts; a completing request only releases the popover's shared
    // busy state if it's still the most recent one — otherwise a slow, stale request finishing
    // late could re-enable the popover mid-way through a newer request (or clobber it entirely).
    let saveRequestToken = 0;

    rangeToggle?.addEventListener("change", () => {
      rangeFields.classList.toggle("hidden", !rangeToggle.checked);
    });

    const statusLabel = (s) => ({ present: 'Present', absent: 'Absent', wfh: 'WFH', sl: 'Sick Leave', vl: 'Vacation Leave', 'non-working': 'Non-working', unmarked: 'Unmarked' }[s] || s);

    // Shared loading-state helpers so every toggle/save action gives visible feedback instead of
    // silently "freezing" while its request is in flight. Buttons keep their original size/label
    // (just visually hidden behind a centered spinner) so nothing resizes or reflows mid-request.
    const setButtonLoading = (btn, loading) => {
      if (!btn) return;
      btn.disabled = loading;
      btn.classList.toggle('is-loading', loading);
    };

    const setPopoverBusy = (busy) => {
      popover.classList.toggle('popover-busy', busy);
      popover.querySelectorAll('button, input').forEach((el) => { el.disabled = busy; });
    };

    const showCellSaving = (cell) => {
      if (cell.querySelector(':scope > .cell-spinner-overlay')) return;
      const overlay = document.createElement('div');
      overlay.className = 'cell-spinner-overlay';
      cell.appendChild(overlay);
    };
    const hideCellSaving = (cell) => {
      cell.querySelector(':scope > .cell-spinner-overlay')?.remove();
    };

    const clearPopoverLoading = () => {
      setPopoverBusy(false);
      popover.querySelectorAll('.is-loading').forEach((btn) => setButtonLoading(btn, false));
    };

    const closePopover = () => {
      popover?.classList.add("hidden");
      activeCell = null;
      clearPopoverLoading();
    };

    const openPopover = (cell) => {
      activeCell = cell;
      clearPopoverLoading();
      const rect = cell.getBoundingClientRect();
      popover.classList.remove("hidden");
      popover.style.top = `${rect.bottom + 6}px`;
      popover.style.left = `${rect.left}px`;

      requestAnimationFrame(() => {
        const pRect = popover.getBoundingClientRect();
        if (pRect.right > window.innerWidth - 8) {
          popover.style.left = `${Math.max(8, window.innerWidth - pRect.width - 8)}px`;
        }
        if (pRect.bottom > window.innerHeight - 8) {
          popover.style.top = `${rect.top - pRect.height - 6}px`;
        }
      });

      const niceDate = new Date(`${cell.dataset.date}T00:00:00`).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
      popoverDate.innerHTML = `<span class="popover-date-text">${niceDate}</span><span class="popover-status-badge status-${cell.dataset.status}">${statusLabel(cell.dataset.status)}</span>`;
      // A day with real logged sessions already speaks for itself — editing its status would just
      // contradict the actual record, so the status controls only show up for days with no logs.
      popoverEditSection.classList.add("hidden");
      loadLogsInto(popoverLogs, cell.dataset.date, (data) => {
        popoverEditSection.classList.toggle("hidden", !!data && data.items.length > 0);
      });
      halfDayCheckbox.checked = cell.dataset.half === '1';

      reasonInput.value = cell.dataset.reason || '';

      rangeToggle.checked = false;
      rangeFields.classList.add("hidden");
      endDateInput.min = cell.dataset.date;
      endDateInput.value = '';
    };

    document.getElementById("calendar-grid")?.addEventListener("click", (e) => {
      const cell = e.target.closest(".day-cell.editable");
      if (!cell) return;
      if (activeCell === cell && !popover.classList.contains("hidden")) {
        closePopover();
      } else {
        openPopover(cell);
      }
    });

    document.getElementById("popover-close")?.addEventListener("click", closePopover);
    document.getElementById("popover-dismiss")?.addEventListener("click", closePopover);
    document.addEventListener("click", (e) => {
      if (!activeCell) return;
      if (popover.contains(e.target) || e.target.closest(".day-cell")) return;
      closePopover();
    });

    const applyResultToCell = (cell, day) => {
      cell.className = `day-cell status-${day.status} ${day.isHalfDay ? 'half-day' : ''} ${day.isUndertime ? 'undertime' : ''} editable`;
      cell.dataset.status = day.status;
      cell.dataset.half = day.isHalfDay ? '1' : '0';
      cell.dataset.reason = day.reason || '';
      if (day.reason) cell.title = day.reason;
      else cell.removeAttribute('title');

      cell.querySelectorAll('.day-hours, .holiday-dot, .undertime-badge, .cell-reason').forEach(el => el.remove());
      const dayNum = cell.querySelector('.day-num');
      if (day.reason) {
        const note = document.createElement('span');
        note.className = 'cell-reason';
        note.textContent = day.reason;
        dayNum.after(note);
      }
      if (day.isHoliday) {
        const dot = document.createElement('span');
        dot.className = 'holiday-dot';
        dot.title = day.holidayLabel || 'Holiday';
        dayNum.after(dot);
      }
      if (day.isUndertime) {
        const badge = document.createElement('span');
        badge.className = 'undertime-badge';
        badge.title = 'Undertime';
        badge.textContent = 'UT';
        cell.appendChild(badge);
      }
      if (day.totalSeconds > 0) {
        const hours = document.createElement('span');
        hours.className = 'day-hours';
        hours.textContent = `${(day.totalSeconds / 3600).toFixed(1)}h`;
        cell.appendChild(hours);
      }
    };

    const saveStatus = async (status, triggerBtn) => {
      if (!activeCell) return;
      // Snapshot the cell + popover-close now: activeCell/closePopover can change while this
      // request is in flight (user clicks another day, closes the popover, etc.), and we must
      // keep updating the day this save was actually for, not whatever is "active" once it resolves.
      const cell = activeCell;
      const date = cell.dataset.date;
      const isHalfDay = halfDayCheckbox.checked;
      const isRange = rangeToggle.checked;
      const reason = reasonInput.value.trim();

      if (isRange && (!endDateInput.value || endDateInput.value < date)) {
        window.showToast?.('Pick a valid end date for the range', 'error');
        return;
      }

      // This request "owns" the popover's busy state only until a newer one starts (e.g. the
      // user switches to another day mid-request). Only the current owner is allowed to release it.
      const myToken = ++saveRequestToken;
      const stillOwnsPopover = () => saveRequestToken === myToken;

      setPopoverBusy(true);
      setButtonLoading(triggerBtn, true);
      showCellSaving(cell);

      try {
        const res = await fetch('/api/attendance/save-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ date, endDate: isRange ? endDateInput.value : undefined, status, isHalfDay, reason }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to save');

        if (data.bulk) {
          const skippedNote = data.skipped ? ` (${data.skipped} non-working day(s) skipped)` : '';
          window.showToast?.(`Marked ${statusLabel(status)} for ${data.count} day(s)${skippedNote}`, 'success');
          window.location.reload();
          return;
        }

        if (cell.isConnected) applyResultToCell(cell, data.day);
        window.showToast?.(`${date} marked ${statusLabel(data.day.status)}`, 'success');
        if (activeCell === cell && stillOwnsPopover()) closePopover();
      } catch (err) {
        window.showToast?.(err.message || 'Error saving attendance', 'error');
      } finally {
        if (cell.isConnected) hideCellSaving(cell);
        // Always release this specific button — it can't have a newer overlapping request of its
        // own since it stays disabled for the whole time this one is in flight.
        setButtonLoading(triggerBtn, false);
        if (stillOwnsPopover()) setPopoverBusy(false);
      }
    };

    document.querySelectorAll('.status-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => saveStatus(btn.dataset.status, e.currentTarget));
    });
    document.getElementById('popover-clear')?.addEventListener('click', (e) => saveStatus('clear', e.currentTarget));

    // Config modal
    const configModal = document.getElementById('config-modal');
    document.getElementById('config-btn')?.addEventListener('click', () => configModal?.classList.add('active'));
    document.getElementById('config-close')?.addEventListener('click', () => configModal?.classList.remove('active'));

    document.getElementById('config-save-btn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const nonWorkingWeekdays = Array.from(document.querySelectorAll('.nonworking-check:checked')).map(el => parseInt(el.value));
      const fullDayHours = parseFloat(document.getElementById('full-day-hours').value);

      setButtonLoading(btn, true);
      try {
        const res = await fetch('/api/attendance/save-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nonWorkingWeekdays, fullDayHours }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to save config');
        window.location.reload();
      } catch (err) {
        window.showToast?.(err.message || 'Error saving configuration', 'error');
        setButtonLoading(btn, false);
      }
    });

    document.getElementById('holiday-add-btn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const dateInput = document.getElementById('holiday-date-input');
      const labelInput = document.getElementById('holiday-label-input');
      if (!dateInput.value) {
        window.showToast?.('Pick a date first', 'error');
        return;
      }

      setButtonLoading(btn, true);
      try {
        const res = await fetch('/api/attendance/holidays', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ date: dateInput.value, label: labelInput.value || 'Holiday' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to add holiday');

        const list = document.getElementById('holiday-list');
        const row = document.createElement('div');
        row.className = 'holiday-row';
        row.dataset.id = data.holiday.id;
        row.innerHTML = `<span class="holiday-date">${data.holiday.date}</span><span class="holiday-label">${data.holiday.label}</span><button class="holiday-remove-btn" data-id="${data.holiday.id}"><span class="btn-label">&times;</span></button>`;
        list.appendChild(row);
        dateInput.value = '';
        labelInput.value = '';
        window.showToast?.('Holiday added', 'success');
      } catch (err) {
        window.showToast?.(err.message || 'Error adding holiday', 'error');
      } finally {
        setButtonLoading(btn, false);
      }
    });

    document.getElementById('holiday-list')?.addEventListener('click', async (e) => {
      const btn = e.target.closest('.holiday-remove-btn');
      if (!btn) return;
      const id = btn.dataset.id;

      setButtonLoading(btn, true);
      try {
        const res = await fetch('/api/attendance/holidays', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to remove holiday');
        btn.closest('.holiday-row')?.remove();
        window.showToast?.('Holiday removed', 'success');
      } catch (err) {
        window.showToast?.(err.message || 'Error removing holiday', 'error');
        setButtonLoading(btn, false);
      }
    });
  }
</script>

<style>
  #portal-body {
    display: flex;
    min-height: 100vh;
    padding-top: 56px;
  }
  #portal-main {
    margin-left: 220px;
    flex: 1;
    padding: 40px;
    position: relative;
  }

  .bg-grid {
    position: fixed;
    inset: 0;
    background-image: linear-gradient(rgba(237, 102, 33, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(237, 102, 33, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .page-header { max-width: 900px; margin: 0 auto 20px; }
  .page-header h1 { font-size: 26px; font-weight: 700; color: var(--text-primary); }
  .page-subtitle { font-size: 13px; color: var(--text-secondary); margin-top: 4px; display: flex; align-items: center; gap: 10px; }
  .readonly-pill {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
    background: rgba(96, 165, 250, 0.12); color: #60a5fa; border: 1px solid rgba(96, 165, 250, 0.3);
    padding: 3px 8px; border-radius: 6px;
  }

  .actions-bar {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    margin: 0 auto 20px; max-width: 900px; flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-subtle);
    padding: 12px 16px; border-radius: 14px;
  }
  .month-selector { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex: 1; min-width: 0; }
  .att-select {
    background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-primary); padding: 8px 10px; border-radius: 8px; outline: none;
    font-size: 13px; font-weight: 500; cursor: pointer;
  }
  .att-select option { background: #111827; color: white; }
  .config-btn {
    display: flex; align-items: center; gap: 8px;
    background: rgba(237, 102, 33, 0.1); border: 1px solid rgba(237, 102, 33, 0.3);
    color: var(--ntv-orange); padding: 10px 16px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;
  }
  .config-btn:hover { background: rgba(237, 102, 33, 0.18); }

  .legend { display: flex; gap: 16px; flex-wrap: wrap; max-width: 900px; margin: 0 auto 16px; font-size: 12px; color: var(--text-secondary); }
  .legend-item { display: flex; align-items: center; gap: 6px; }
  .swatch { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
  .swatch.present { background: var(--att-present); }
  .swatch.absent { background: var(--att-absent); }
  .swatch.wfh { background: var(--att-wfh); }
  .swatch.sl { background: var(--att-sl); }
  .swatch.vl { background: var(--att-vl); }
  .swatch.non-working { background: var(--att-nonworking-bg); border: 1px solid var(--border-subtle); }
  .swatch.ongoing { background: var(--att-cell-empty); border: 2px solid #60a5fa; box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.25); }

  .calendar-wrapper { max-width: 900px; margin: 0 auto; }
  .calendar-grid {
    display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px;
    background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-subtle);
    border-radius: 14px; padding: 16px;
  }
  .weekday-header { text-align: center; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-secondary); padding-bottom: 6px; }

  .day-cell {
    position: relative; min-height: 64px; border-radius: 8px; padding: 6px 8px;
    display: flex; flex-direction: column; justify-content: space-between;
    font-size: 11px; color: var(--text-primary);
  }
  .day-cell.blank { background: transparent; }
  .day-num { font-size: 13px; font-weight: 700; }
  .day-hours { font-size: 10px; opacity: 0.85; align-self: flex-end; }
  .holiday-dot { position: absolute; top: 6px; right: 8px; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  /* The reason reads straight off the cell — a hover tooltip is no use on a phone. */
  .cell-reason {
    font-size: 9px; line-height: 1.25; opacity: .9; margin-top: 2px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; word-break: break-word;
  }

  .reason-summary {
    max-width: 900px; margin: 20px auto 0; padding: 18px 20px;
    background: var(--card-bg); border: 1px solid var(--border-subtle); border-radius: 14px;
  }
  .reason-summary-title {
    font-size: 13px; font-weight: 700; color: var(--text-primary);
    margin-bottom: 14px; letter-spacing: .01em;
  }
  .reason-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .reason-item {
    display: grid; grid-template-columns: 12px 130px 92px 1fr; align-items: baseline; gap: 12px;
    font-size: 12.5px; color: var(--text-secondary);
  }
  .reason-item .swatch { align-self: center; }
  .reason-dates { display: flex; align-items: baseline; gap: 7px; font-weight: 700; color: var(--text-primary); white-space: nowrap; }
  .reason-daycount {
    font-size: 9.5px; font-weight: 700; color: var(--text-secondary);
    background: rgba(127,127,127,.12); padding: 2px 6px; border-radius: 5px;
  }
  .reason-status { font-weight: 600; color: var(--text-secondary); white-space: nowrap; }
  .reason-text { color: var(--text-primary); }

  @media (max-width: 700px) {
    .reason-item { grid-template-columns: 12px 1fr; row-gap: 3px; }
    .reason-status, .reason-text { grid-column: 2; }
  }
  .undertime-badge {
    position: absolute; bottom: 6px; left: 8px; font-size: 8px; font-weight: 800;
    letter-spacing: .02em; padding: 1px 4px; border-radius: 4px;
    background: rgba(5, 11, 22, 0.35); color: inherit;
  }

  .day-cell.editable, .day-cell.viewable { cursor: pointer; transition: transform 0.15s; }
  .day-cell.editable:hover, .day-cell.viewable:hover { transform: translateY(-1px); box-shadow: 0 4px 10px rgba(0,0,0,0.25); }

  /* A separate overlay element (not a class on the cell itself) so it survives the cell's
     className being fully replaced mid-request when the new status is applied. */
  .cell-spinner-overlay {
    position: absolute; inset: 0; z-index: 2; border-radius: inherit;
    display: flex; align-items: center; justify-content: center;
    background: rgba(5, 11, 22, 0.45);
  }
  .cell-spinner-overlay::after {
    content: ''; width: 14px; height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3); border-top-color: #fff;
    border-radius: 50%; animation: btn-spin 0.6s linear infinite;
  }

  .day-cell.status-present, .day-cell.status-absent, .day-cell.status-wfh, .day-cell.status-sl, .day-cell.status-vl {
    color: #050b16;
  }
  .day-cell.status-present { background: var(--att-present); }
  .day-cell.status-absent { background: var(--att-absent); }
  .day-cell.status-wfh { background: var(--att-wfh); }
  .day-cell.status-sl { background: var(--att-sl); }
  .day-cell.status-vl { background: var(--att-vl); color: #fff; }

  .day-cell.status-present.half-day { background: linear-gradient(135deg, var(--att-present) 50%, var(--att-cell-empty) 50%); color: var(--text-primary); }
  .day-cell.status-absent.half-day { background: linear-gradient(135deg, var(--att-absent) 50%, var(--att-cell-empty) 50%); color: var(--text-primary); }
  .day-cell.status-wfh.half-day { background: linear-gradient(135deg, var(--att-wfh) 50%, var(--att-cell-empty) 50%); color: var(--text-primary); }
  .day-cell.status-sl.half-day { background: linear-gradient(135deg, var(--att-sl) 50%, var(--att-cell-empty) 50%); color: var(--text-primary); }
  .day-cell.status-vl.half-day { background: linear-gradient(135deg, var(--att-vl) 50%, var(--att-cell-empty) 50%); color: var(--text-primary); }

  .day-cell.status-non-working { background: var(--att-nonworking-bg); color: var(--att-nonworking-text); }
  .day-cell.status-unmarked { background: var(--att-cell-empty); border: 1px dashed var(--border-subtle); }

  /* Today's cell while a timer is actively running — no logged time yet, so the status colors
     above don't apply, but a blank cell would read as "not present" while clocked in. */
  .day-cell.ongoing { box-shadow: 0 0 0 2px #60a5fa; animation: ongoing-pulse 2s ease-in-out infinite; }
  @keyframes ongoing-pulse {
    0%, 100% { box-shadow: 0 0 0 2px #60a5fa; }
    50% { box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.4); }
  }

  /* Status popover */
  .status-popover {
    position: fixed; z-index: 3000; background: var(--modal-bg); border: 1px solid var(--border-subtle);
    border-radius: 12px; padding: 0; width: min(300px, calc(100vw - 24px)); box-shadow: 0 12px 32px rgba(0,0,0,0.4);
    max-height: calc(100vh - 24px); overflow-y: auto;
  }
  .status-popover.hidden { display: none; }
  .status-popover.popover-busy { opacity: 0.92; transition: opacity .15s ease; }

  @keyframes btn-spin { to { transform: rotate(360deg); } }

  /* Loading buttons: hide the label in place (layout space is preserved, so nothing resizes)
     and show a centered spinner using the button's own text color for contrast. */
  button.is-loading { position: relative; cursor: wait; pointer-events: none; }
  button.is-loading .btn-label { visibility: hidden; }
  button.is-loading::after {
    content: '';
    position: absolute; top: 50%; left: 50%;
    width: 14px; height: 14px; margin: -7px 0 0 -7px;
    border: 2px solid rgba(128, 128, 128, 0.35); border-top-color: currentColor;
    border-radius: 50%; animation: btn-spin 0.6s linear infinite;
  }
  .status-popover button:disabled:not(.is-loading),
  .modal-content button:disabled:not(.is-loading),
  :global(.holiday-row button:disabled:not(.is-loading)) {
    opacity: 0.6; cursor: not-allowed;
  }
  .popover-header {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 12px 16px; background: rgba(255, 255, 255, 0.02); border-bottom: 1px solid var(--border-subtle);
  }
  .popover-date { display: flex; align-items: center; gap: 8px; }
  /* :global() on every selector below that targets markup built in the <script> via innerHTML /
     createElement — that markup never gets Astro's data-astro-cid attribute, so scoped rules miss it. */
  :global(.popover-date-text) { font-size: 13px; font-weight: 700; color: var(--text-primary); }
  :global(.popover-status-badge) {
    font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .03em;
    padding: 2px 8px; border-radius: 5px; color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);
  }
  :global(.popover-status-badge.status-present) { border-color: rgba(34, 197, 94, 0.4); color: var(--att-present); }
  :global(.popover-status-badge.status-absent) { border-color: rgba(225, 29, 72, 0.4); color: var(--att-absent); }
  :global(.popover-status-badge.status-wfh) { border-color: rgba(250, 204, 21, 0.4); color: var(--att-wfh); }
  :global(.popover-status-badge.status-sl) { border-color: rgba(245, 158, 11, 0.4); color: var(--att-sl); }
  :global(.popover-status-badge.status-vl) { border-color: rgba(139, 92, 246, 0.4); color: var(--att-vl); }
  .popover-dismiss-btn {
    flex-shrink: 0; background: none; border: none; color: var(--text-secondary); cursor: pointer;
