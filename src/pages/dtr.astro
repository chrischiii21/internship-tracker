---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { getSession } from "../lib/auth";
import { parse } from "cookie";
import DtrData from "../components/DtrData.astro";
import DtrSheet from "../components/DtrSheet.astro";
import { getAppSettings } from "../lib/settings";
import { supabase } from "../lib/supabase";

const cookieHeader = Astro.request.headers.get("cookie") || "";
const cookies = parse(cookieHeader);
const user = cookies.session ? await getSession(cookies.session) : null;

if (!user) return Astro.redirect("/");

const mySettings = await getAppSettings(user.id);
const targetStudentId = Astro.url.searchParams.get("studentId");
let viewUserId = user.id;

// Coordinator Logic
let students = [];
let sections = [];
let filteredStudents = [];
const selectedSection = Astro.url.searchParams.get("section") || "all";

if (mySettings.role === "coordinator") {
  // Fetch coordinator sections
  const { data: mySections } = await supabase
    .from("coordinator_sections")
    .select("*")
    .eq("coordinator_id", user.id)
    .order("section_name", { ascending: true });
  sections = mySections || [];

  // Fetch all students under coordinator, including section_id
  const { data: myStudents } = await supabase
    .from("student_settings")
    .select("user_id, user_name, section_id")
    .eq("coordinator_id", user.id);
  students = myStudents || [];

  // Apply section filtering
  filteredStudents = students;
  if (selectedSection !== "all") {
    filteredStudents = students.filter(s => s.section_id === selectedSection);
  }

  // Determine current viewUserId based on filtered student list
  if (targetStudentId && students.some((s) => s.user_id === targetStudentId)) {
    const isStudentInFiltered = selectedSection === 'all' || 
      (students.find(s => s.user_id === targetStudentId)?.section_id === selectedSection);

    if (isStudentInFiltered) {
      viewUserId = targetStudentId;
    } else if (filteredStudents.length > 0) {
      viewUserId = filteredStudents[0].user_id;
    }
  } else if (filteredStudents.length > 0) {
    viewUserId = filteredStudents[0].user_id;
  }
}

const settings = await getAppSettings(viewUserId);
const now = new Date();
const currentMonth = now.getMonth() + 1;
const currentYear = now.getFullYear();

const month = parseInt(
  Astro.url.searchParams.get("month") || currentMonth.toString(),
);
const year = parseInt(
  Astro.url.searchParams.get("year") || currentYear.toString(),
);


const monthName = new Date(year, month - 1)
  .toLocaleDateString("en-US", { month: "long", timeZone: "Asia/Manila" })
  .toUpperCase();

const needsUpdate = settings.isEmployee 
  ? (!settings.hostCompany || settings.hostCompany.includes("Enter"))
  : ((settings.program?.includes("Enter") ?? true) ||
     (settings.hostCompany?.includes("Enter") ?? true) ||
     (settings.supervisor?.includes("Enter") ?? true));

const isEditable = user.id === viewUserId || mySettings.role === "coordinator";

const totalRequiredHours = settings.isEmployee ? 0 : settings.targetHours;
---

<Layout title="DTR Sheet">
  <Header user={user} />

  <div id="portal-body">
    <Sidebar user={user} activeTab="dtr" role={mySettings.role} />

    <main id="portal-main">
      <div class="bg-grid" aria-hidden="true"></div>

      {
        needsUpdate && (
          <div class="no-print settings-alert">
            <div class="alert-content">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01" />
              </svg>
              <span>
                Your DTR details are incomplete. Please update them in the
                settings.
              </span>
            </div>
            <a href="/settings" class="alert-link">
              Go to Settings
            </a>
          </div>
        )
      }

      <div class="no-print actions-bar">
        <div class="month-selector">
          {
            mySettings.role === "coordinator" && (
              <>
                <select
                  id="section-selector"
                  class="dtr-select"
                >
                  <option value="all" selected={selectedSection === 'all'}>All Sections</option>
                  {sections.map((sec) => (
                    <option value={sec.id} selected={sec.id === selectedSection}>
                      {sec.section_name}
                    </option>
                  ))}
                </select>

                <select
                  id="student-selector"
                  class="dtr-select"
                  disabled={filteredStudents.length === 0}
                >
                  {filteredStudents.length > 0 ? (
                    filteredStudents.map((s) => (
                      <option value={s.user_id} selected={s.user_id === viewUserId}>
                        {s.user_name}
                      </option>
                    ))
                  ) : (
                    <option value="">No students in section</option>
                  )}
                </select>
              </>
            )
          }
          <select id="month-selector" class="dtr-select">
            {
              Array.from({ length: 12 }).map((_, i) => (
                <option value={i + 1} selected={month === i + 1}>
                  {new Date(0, i).toLocaleString("en-US", { month: "long" })}
                </option>
              ))
            }
          </select>
          <select id="year-selector" class="dtr-select">
            {
              [2024, 2025, 2026].map((y) => (
                <option value={y} selected={year === y}>
                  {y}
                </option>
              ))
            }
          </select>
        </div>
        <div class="actions-group">
          <button onclick="window.print()" class="print-btn">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path
                d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
              ></path><rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            Print DTR
          </button>
          <button
            id="download-pdf-btn"
            class="download-btn"
            data-filename={`DTR_${settings.userName?.replace(/\s+/g, "_") || (settings.isEmployee ? "Employee" : "Student")}_${monthName}_${year}.pdf`}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
            </svg>
            Download PDF
          </button>
          {!settings.isEmployee && (
            <button id="school-form-btn" class="school-form-btn" data-tour="school-form">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" />
              </svg>
              School Form PDF
            </button>
          )}
        </div>
      </div>

      <DtrData
        server:defer
        viewerId={user.id}
        viewUserId={viewUserId}
        month={month}
        year={year}
        isEditable={isEditable}
        isCoordinator={mySettings.role === "coordinator"}
      >
        <DtrSheet
          slot="fallback"
          settings={settings}
          viewUserId={viewUserId}
          month={month}
          year={year}
          isEditable={isEditable}
          isCoordinator={mySettings.role === "coordinator"}
        />
      </DtrData>

      {!settings.isEmployee && (
        <>
          <div id="school-form-modal" class="modal-overlay no-print">
            <div class="modal-content">
              <h2 class="modal-title">Official School DTR Form</h2>
              <p class="modal-desc">
                These are the details schools print on their own practicum form. They're saved on this
                device, so you only fill them in once.
              </p>

              <div class="sf-grid">
                <label class="sf-field">
                  <span>School / University</span>
                  <input id="sf-school" type="text" placeholder="e.g. Bicol University" />
                </label>
                <label class="sf-field">
                  <span>College / Department</span>
                  <input id="sf-college" type="text" placeholder="e.g. College of Science" />
                </label>
                <label class="sf-field">
                  <span>Course &amp; Section</span>
                  <input id="sf-section" type="text" placeholder="e.g. BSIT 4-A" value={settings.program || ""} />
                </label>
                <label class="sf-field">
                  <span>School Year / Term</span>
                  <input id="sf-term" type="text" placeholder="e.g. A.Y. 2025–2026, 2nd Sem" />
                </label>
                <label class="sf-field">
                  <span>Practicum Adviser / Coordinator</span>
                  <input id="sf-adviser" type="text" placeholder="Full name" />
                </label>
                <label class="sf-field">
                  <span>Required Hours</span>
                  <input id="sf-required" type="number" min="0" value={totalRequiredHours} />
                </label>
              </div>

              <div class="modal-actions-row">
                <button type="button" id="sf-cancel" class="btn-cancel">Cancel</button>
                <button type="button" id="sf-generate" class="download-btn">Generate PDF</button>
              </div>
            </div>
          </div>

          <div
            id="official-form"
            class="official-form"
            aria-hidden="true"
            data-student={settings.userName || ""}
            data-company={settings.hostCompany || ""}
            data-supervisor={settings.supervisor || ""}
            data-supervisor-position={settings.supervisorPosition || ""}
            data-period={`${monthName} ${year}`}
            data-filename={`Official_DTR_${(settings.userName || "Student").replace(/\s+/g, "_")}_${monthName}_${year}.pdf`}
          >
            <div class="of-head">
              <div class="of-school" id="of-school"></div>
              <div class="of-college" id="of-college"></div>
              <div class="of-doc-title">DAILY TIME RECORD</div>
              <div class="of-doc-sub">On-the-Job Training / Practicum</div>
            </div>

            <div class="of-info">
              <div class="of-info-row"><span class="of-lbl">Name of Student:</span><span class="of-val" id="of-student"></span></div>
              <div class="of-info-row"><span class="of-lbl">Course &amp; Section:</span><span class="of-val" id="of-section"></span></div>
              <div class="of-info-row"><span class="of-lbl">Cooperating Agency:</span><span class="of-val" id="of-company"></span></div>
              <div class="of-info-row"><span class="of-lbl">School Year / Term:</span><span class="of-val" id="of-term"></span></div>
              <div class="of-info-row"><span class="of-lbl">Immediate Supervisor:</span><span class="of-val" id="of-supervisor"></span></div>
              <div class="of-info-row"><span class="of-lbl">Covered Period:</span><span class="of-val" id="of-period"></span></div>
            </div>

            <table class="of-table">
              <thead>
                <tr>
                  <th rowspan="2" class="of-col-day">Date</th>
                  <th colspan="2">Morning</th>
                  <th colspan="2">Afternoon</th>
                  <th rowspan="2" class="of-col-total">Total Hours</th>
                </tr>
                <tr>
                  <th>Time In</th>
                  <th>Time Out</th>
                  <th>Time In</th>
                  <th>Time Out</th>
                </tr>
              </thead>
              <tbody id="of-tbody"></tbody>
              <tfoot>
                <tr>
                  <td colspan="5" class="of-total-label">TOTAL HOURS RENDERED THIS PERIOD</td>
                  <td class="of-total-val" id="of-period-total"></td>
                </tr>
                <tr>
                  <td colspan="5" class="of-total-label">TOTAL HOURS REQUIRED</td>
                  <td class="of-total-val" id="of-required"></td>
                </tr>
              </tfoot>
            </table>

            <div class="of-cert">
              I hereby certify that the entries above are true and correct records of the hours I rendered.
            </div>

            <div class="of-sign-row">
              <div class="of-sign">
                <div class="of-sign-line"></div>
                <div class="of-sign-label">Signature of Student</div>
              </div>
              <div class="of-sign">
                <div class="of-sign-line of-sign-name" id="of-supervisor-name"></div>
                <div class="of-sign-label">Signature over Printed Name of Supervisor</div>
                <div class="of-sign-sub" id="of-supervisor-position"></div>
              </div>
            </div>

            <div class="of-sign-row of-sign-row-single">
              <div class="of-sign">
                <div class="of-sign-line of-sign-name" id="of-adviser"></div>
                <div class="of-sign-label">Noted by: Practicum Adviser / Coordinator</div>
              </div>
            </div>
          </div>
        </>
      )}
    </main>
  </div>
</Layout>

<script>
  import html2pdf from 'html2pdf.js/dist/html2pdf.min.js';

  const secSel = document.getElementById("section-selector");
  const sSel = document.getElementById("student-selector");
  const mSel = document.getElementById("month-selector");
  const ySel = document.getElementById("year-selector");

  const buildUrl = (e) => {
    let url = `/dtr?month=${mSel.value}&year=${ySel.value}`;
    if (secSel?.value) url += `&section=${secSel.value}`;

    // Only pass studentId if the change didn't trigger from the section selector itself
    if (e?.target !== secSel && sSel?.value) {
      url += `&studentId=${sSel.value}`;
    }
    return url;
  };

  // Switching month/year re-requests only the sheet's server island (with ?month=&year= added to
  // its URL) and swaps it in, instead of reloading the whole page. Section/student changes still
  // navigate, since they rebuild the selectors themselves.
  const loadMonth = async (e) => {
    const url = buildUrl(e);
    const island = document.querySelector('link[rel="preload"][href*="/_server-islands/DtrData"]')?.getAttribute("href");
    const current = document.getElementById("dtr-data");
    if (!island || !current) {
      window.location.href = url;
      return;
    }
    // Selects stay locked until the new month lands, so two switches can't race each other.
    mSel.disabled = ySel.disabled = true;
    const hideLoader = window.showSectionLoading?.(
      current.querySelector(".dtr-scroll-wrapper"),
      `Loading ${mSel.options[mSel.selectedIndex].text} ${ySel.value}`
    );
    try {
      const res = await fetch(`${island}&month=${mSel.value}&year=${ySel.value}`);
      if (!res.ok) throw new Error("fallback");
      // A contextual fragment (not innerHTML) so the island's own script runs and re-binds the grid.
      const fresh = document.createRange().createContextualFragment(await res.text());
      if (!fresh.getElementById("dtr-data")) throw new Error("fallback");
      current.replaceWith(fresh);
      history.replaceState(null, "", url);
    } catch {
      window.location.href = url;
      return; // leave the loader up while the full page load takes over
    }
    hideLoader?.();
    mSel.disabled = ySel.disabled = false;
  };

  secSel?.addEventListener("change", (e) => { window.location.href = buildUrl(e); });
  sSel?.addEventListener("change", (e) => { window.location.href = buildUrl(e); });
  mSel?.addEventListener("change", loadMonth);
  ySel?.addEventListener("change", loadMonth);

  const params = new URLSearchParams(window.location.search);
  const successVal = params.get('success');
  if (successVal) {
    const msg = successVal === 'true' ? 'DTR updated successfully' : successVal;
    window.showToast(msg, 'success');
    const newUrl = window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }
  if (params.get('error')) {
    window.showToast(decodeURIComponent(params.get('error')), 'error');
    const newUrl = window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }

  // PDF Download Handling
  const downloadBtn = document.getElementById("download-pdf-btn");
  downloadBtn?.addEventListener("click", () => {
    if (window.showToast) {
      window.showToast("Generating PDF, please wait...", "info");
    }

    const element = document.getElementById("dtr-sheet");
    const filename = downloadBtn.getAttribute("data-filename") || "DTR_Sheet.pdf";

    const opt = {
      margin:       0,
      filename:     filename,
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true, logging: false },
      jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
    };

    if (html2pdf) {
      html2pdf()
        .set(opt)
        .from(element)
        .save()
        .then(() => {
          if (window.showToast) {
            window.showToast("PDF downloaded successfully!", "success");
          }
        })
        .catch((err) => {
          console.error("PDF generation failed:", err);
          if (window.showToast) {
            window.showToast("Failed to generate PDF. Please try again.", "error");
          }
        });
    } else {
      if (window.showToast) {
        window.showToast("PDF generator library is not loaded. Please try again.", "error");
      }
    }
  });

  // Official School Form export: the same month's punches re-laid out on the formal, black-and-white
  // sheet schools actually collect, with the school-specific details students fill in once.
  const schoolFormBtn = document.getElementById("school-form-btn");
  const schoolModal = document.getElementById("school-form-modal");
  const officialForm = document.getElementById("official-form");
  const SCHOOL_FORM_STORE = "internflow_school_form";

  const sfFields = {
    school: document.getElementById("sf-school"),
    college: document.getElementById("sf-college"),
    section: document.getElementById("sf-section"),
    term: document.getElementById("sf-term"),
    adviser: document.getElementById("sf-adviser"),
    required: document.getElementById("sf-required"),
  };

  const setText = (id, value) => {
    const el = document.getElementById(id);
    if (el) el.textContent = value || "";
  };

  function cellValue(row, col, fallbackIndex) {
    const input = row.querySelector(`input[data-col="${col}"]`);
    if (input) return input.value.trim();
    const cells = row.querySelectorAll("td");
    return cells[fallbackIndex] ? cells[fallbackIndex].textContent.trim() : "";
  }

  function rowTotal(row) {
    const cell = row.querySelector(".row-total");
    if (!cell) return "";
    // "No log — input needed" style hints live in a span; they aren't a duration.
    return cell.querySelector("span") ? "" : cell.textContent.trim();
  }

  function buildOfficialForm() {
    const tbody = document.getElementById("of-tbody");
    if (!tbody || !officialForm) return;
    tbody.replaceChildren();

    document.querySelectorAll("#dtr-sheet tbody tr").forEach((row) => {
      const values = [
        row.getAttribute("data-day") || "",
        cellValue(row, "amIn", 1),
        cellValue(row, "amOut", 2),
        cellValue(row, "pmIn", 3),
        cellValue(row, "pmOut", 4),
        rowTotal(row),
      ];
      const tr = document.createElement("tr");
      if (!values[5]) tr.className = "of-row-nolog";
      values.forEach((value) => {
        const td = document.createElement("td");
        td.textContent = value;
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });

    const data = officialForm.dataset;
    setText("of-school", sfFields.school?.value.trim());
    setText("of-college", sfFields.college?.value.trim());
    setText("of-section", sfFields.section?.value.trim());
    setText("of-term", sfFields.term?.value.trim());
    setText("of-adviser", sfFields.adviser?.value.trim());
    setText("of-student", data.student);
    setText("of-company", data.company);
    setText("of-supervisor", data.supervisor);
    setText("of-supervisor-name", data.supervisor);
    setText("of-supervisor-position", data.supervisorPosition ? `Position: ${data.supervisorPosition}` : "");
    setText("of-period", data.period);
    setText("of-period-total", document.getElementById("total-monthly-hours-val")?.textContent.trim());
    const required = sfFields.required?.value.trim();
    setText("of-required", required ? `${required} hrs` : "");
  }

  function openSchoolModal() {
    try {
      const saved = JSON.parse(localStorage.getItem(SCHOOL_FORM_STORE) || "{}");
      Object.keys(sfFields).forEach((key) => {
        if (saved[key] && sfFields[key]) sfFields[key].value = saved[key];
      });
    } catch (e) {}
    schoolModal?.classList.add("active");
  }

  function closeSchoolModal() {
    schoolModal?.classList.remove("active");
  }

  schoolFormBtn?.addEventListener("click", openSchoolModal);
  document.getElementById("sf-cancel")?.addEventListener("click", closeSchoolModal);
  schoolModal?.addEventListener("click", (e) => {
    if (e.target === schoolModal) closeSchoolModal();
  });

  document.getElementById("sf-generate")?.addEventListener("click", () => {
    const prefs = {};
    Object.keys(sfFields).forEach((key) => {
      prefs[key] = sfFields[key]?.value.trim() || "";
    });
    try {
      localStorage.setItem(SCHOOL_FORM_STORE, JSON.stringify(prefs));
    } catch (e) {}

    buildOfficialForm();
    closeSchoolModal();

    // html2canvas only renders what's laid out on screen, so bring the template into the viewport
    // behind the full-screen loading overlay for the moment it takes to capture.
    window.showLoadingSpinner?.("GENERATING SCHOOL FORM...");
    officialForm.style.left = "0";
    officialForm.style.zIndex = "1";

    const restoreForm = () => {
      officialForm.style.left = "";
      officialForm.style.zIndex = "";
      window.hideLoadingSpinner?.();
    };

    html2pdf()
      .set({
        margin: 0,
        filename: officialForm?.dataset.filename || "Official_DTR.pdf",
        image: { type: "jpeg", quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, logging: false },
        jsPDF: { unit: "in", format: "letter", orientation: "portrait" },
        pagebreak: { mode: ["css", "avoid-all"] },
      })
      .from(officialForm)
      .save()
      .then(() => {
        restoreForm();
        window.showToast?.("School form downloaded", "success");
      })
      .catch((err) => {
        restoreForm();
        console.error("School form generation failed:", err);
        window.showToast?.("Could not generate the school form. Please try again.", "error");
      });
  });

  // Page walkthrough, replayable from the header's tour button.
  window.InternFlowTour?.register("dtr", [
    {
      target: '[data-tour="dtr-source"]',
      title: "Where these hours came from",
      body: "This line tells you whether the sheet includes synced Clockify sessions or only the built-in timer and your manual entries — the usual reason a monthly total looks lower than expected.",
    },
    {
      target: "#dtr-sheet .dtr-table",
      title: "Edit it like a spreadsheet",
      body: "Every time cell is editable. Type a time (e.g. 8, 1:30pm), press Enter or Tab to move on, and the daily and monthly totals recalculate as you go.",
    },
    {
      target: "#download-pdf-btn",
      title: "Download this view",
      body: "Saves exactly what you see here as a PDF — handy for a quick submission or your own records.",
    },
    {
      target: '[data-tour="school-form"]',
      title: "Export the official school form",
      body: "Same month's entries, re-laid out on a formal black-and-white practicum form with certification and signature blocks. Fill in your school details once and they're remembered for next time.",
    },
  ]);

  function parseTimeInput(val) {
    if (!val || !val.trim()) return null;
    val = val.trim().toLowerCase();
    
    const match = val.match(/^(\d{1,2})(?::(\d{2}))?\s*([ap]m|[ap])?$/);
    if (!match) return null;
    
    let hours = parseInt(match[1]);
    let minutes = parseInt(match[2] || '0');
    let ampm = match[3];
    
    if (hours < 0 || hours > 23 || minutes < 0 || minutes > 59) return null;
    
    if (ampm) {
      if (ampm.startsWith('p') && hours < 12) {
        hours += 12;
      } else if (ampm.startsWith('a') && hours === 12) {
        hours = 0;
      }
    } else {
      if (hours >= 1 && hours <= 6) {
        hours += 12;
      }
    }
    
    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
  }

  function formatTime12(time24) {
    if (!time24) return '';
    const [hStr, mStr] = time24.split(':');
    let h = parseInt(hStr);
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    if (h === 0) h = 12;
    return `${h}:${mStr} ${ampm}`;
  }

  // Excel-like DTR Edit and Navigation Logic. Re-run whenever loadMonth swaps in a new sheet.
  function bindGrid() {
  const dtrSheet = document.getElementById("dtr-sheet");
  const userId = dtrSheet?.getAttribute("data-user-id");
  const year = parseInt(dtrSheet?.getAttribute("data-year") || "0");
  const month = parseInt(dtrSheet?.getAttribute("data-month") || "0");

  const inputs = Array.from(document.querySelectorAll('.dtr-grid-input'));

  inputs.forEach(input => {
    input.addEventListener('focus', () => {
      input.dataset.original = input.value;
    });

    input.addEventListener('blur', async () => {
      const rawVal = input.value.trim();
      const originalRaw = input.dataset.original || '';
      
      if (rawVal === originalRaw) return;

      const day = parseInt(input.getAttribute('data-day') || '0');
      const col = input.getAttribute('data-col') || '';

      let parsedTime = null;
      if (rawVal !== '') {
        parsedTime = parseTimeInput(rawVal);
        if (!parsedTime) {
          if (window.showToast) {
            window.showToast(`Invalid time format: "${rawVal}"`, 'error');
          }
          input.value = originalRaw;
          return;
        }
        input.value = formatTime12(parsedTime);
      }

      const amInVal = document.querySelector(`.dtr-grid-input[data-day="${day}"][data-col="amIn"]`)?.value || '';
      const amOutVal = document.querySelector(`.dtr-grid-input[data-day="${day}"][data-col="amOut"]`)?.value || '';
      const pmInVal = document.querySelector(`.dtr-grid-input[data-day="${day}"][data-col="pmIn"]`)?.value || '';
      const pmOutVal = document.querySelector(`.dtr-grid-input[data-day="${day}"][data-col="pmOut"]`)?.value || '';

      const amIn24 = amInVal ? parseTimeInput(amInVal) : null;
      const amOut24 = amOutVal ? parseTimeInput(amOutVal) : null;
      const pmIn24 = pmInVal ? parseTimeInput(pmInVal) : null;
      const pmOut24 = pmOutVal ? parseTimeInput(pmOutVal) : null;

      const row = input.closest('tr');
      row?.classList.add('row-saving');

      try {
        const response = await fetch('/api/dtr/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId,
            year,
            month,
            day,
            amIn: amIn24,
            amOut: amOut24,
            pmIn: pmIn24,
            pmOut: pmOut24
          })
        });

        const resData = await response.json();
        if (!response.ok || resData.error) {
          throw new Error(resData.error || 'Failed to save entry');
        }

        const rowTotalCell = row?.querySelector('.row-total');
        const dateCell = row?.querySelector('.date-col');
        const overrideStatus = row?.dataset.overrideStatus || '';
        const statusLabelMap = { absent: 'ABSENT', wfh: 'WFH', sl: 'SL', vl: 'VL', present: 'PRESENT' };
        const actionableStatuses = new Set(['present', 'wfh']);
        const allStatusClasses = ['status-absent', 'status-wfh', 'status-sl', 'status-vl', 'status-present'];

        if (rowTotalCell) {
          if (resData.dayTotalSeconds > 0) {
            const h = Math.floor(resData.dayTotalSeconds / 3600);
            const m = Math.floor((resData.dayTotalSeconds % 3600) / 60);
            rowTotalCell.textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
            row?.classList.remove('weekend-row', 'needs-time-input', 'attendance-note', ...allStatusClasses);
            dateCell?.querySelector('.dtr-status-badge')?.remove();
          } else if (overrideStatus) {
            // Time was cleared but the day is still flagged in the Attendance Chart — restore the highlight.
            const isActionable = actionableStatuses.has(overrideStatus);
            rowTotalCell.innerHTML = '';
            const hint = document.createElement('span');
            hint.className = isActionable ? 'no-log-hint' : 'attendance-note-hint';
            hint.textContent = isActionable ? 'No log — input needed' : 'No log expected';
            rowTotalCell.appendChild(hint);

            row?.classList.remove('weekend-row', 'needs-time-input', 'attendance-note', ...allStatusClasses);
            row?.classList.add(isActionable ? 'needs-time-input' : 'attendance-note', `status-${overrideStatus}`);
            if (dateCell && !dateCell.querySelector('.dtr-status-badge')) {
              const badge = document.createElement('span');
              badge.className = `dtr-status-badge status-${overrideStatus}`;
              badge.title = `Marked ${statusLabelMap[overrideStatus] || overrideStatus} in Attendance Chart`;
              badge.textContent = statusLabelMap[overrideStatus] || overrideStatus;
              dateCell.appendChild(badge);
            }
          } else {
            rowTotalCell.textContent = '';
            row?.classList.add('weekend-row');
          }
        }

        const totalHeaderVal = document.getElementById('total-monthly-hours-val');
        if (totalHeaderVal) {
          const h = Math.floor(resData.totalMonthSeconds / 3600);
          const m = Math.floor((resData.totalMonthSeconds % 3600) / 60);
          totalHeaderVal.textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
        }

        input.dataset.original = input.value;
        if (window.showToast) {
          window.showToast(`Day ${day} record saved successfully`, 'success');
        }
      } catch (err) {
        console.error(err);
        if (window.showToast) {
          window.showToast(err.message || 'Error saving log', 'error');
        }
        input.value = originalRaw;
      } finally {
        row?.classList.remove('row-saving');
      }
    });

    input.addEventListener('keydown', (e) => {
      const col = input.getAttribute('data-col');
      const day = parseInt(input.getAttribute('data-day') || '0');
      let nextInput = null;

      if (e.key === 'ArrowDown' || e.key === 'Enter') {
        e.preventDefault();
        nextInput = document.querySelector(`.dtr-grid-input[data-day="${day + 1}"][data-col="${col}"]`);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        nextInput = document.querySelector(`.dtr-grid-input[data-day="${day - 1}"][data-col="${col}"]`);
      } else if (e.key === 'ArrowRight') {
        if (input.selectionStart === input.value.length) {
          e.preventDefault();
          const colOrder = ['amIn', 'amOut', 'pmIn', 'pmOut'];
          const nextColIdx = colOrder.indexOf(col) + 1;
          if (nextColIdx < colOrder.length) {
            nextInput = document.querySelector(`.dtr-grid-input[data-day="${day}"][data-col="${colOrder[nextColIdx]}"]`);
          } else {
            nextInput = document.querySelector(`.dtr-grid-input[data-day="${day + 1}"][data-col="${colOrder[0]}"]`);
          }
        }
      } else if (e.key === 'ArrowLeft') {
        if (input.selectionStart === 0) {
          e.preventDefault();
          const colOrder = ['amIn', 'amOut', 'pmIn', 'pmOut'];
          const prevColIdx = colOrder.indexOf(col) - 1;
          if (prevColIdx >= 0) {
            nextInput = document.querySelector(`.dtr-grid-input[data-day="${day}"][data-col="${colOrder[prevColIdx]}"]`);
          } else {
            nextInput = document.querySelector(`.dtr-grid-input[data-day="${day - 1}"][data-col="${colOrder[colOrder.length - 1]}"]`);
          }
        }
      }

      if (nextInput) {
        nextInput.focus();
        nextInput.select();
      }
    });
  });
  }
  // The sheet arrives after the page (DtrData server island), and again on every month switch —
  // each time: point the export buttons at its month, wire up the grid, and (once) start the tour.
  let tourStarted = false;
  function onSheetReady() {
    const sheetData = document.getElementById("dtr-data")?.dataset;
    if (sheetData) {
      document.getElementById("download-pdf-btn")?.setAttribute("data-filename", sheetData.filename);
      document.getElementById("official-form")?.setAttribute("data-filename", sheetData.officialFilename);
      document.getElementById("official-form")?.setAttribute("data-period", sheetData.period);
    }
    bindGrid();
    if (!tourStarted) {
      tourStarted = true;
      window.InternFlowTour?.autoStart();
    }
  }
  if (window.__dtrSheetReady) onSheetReady();
  document.addEventListener("dtr:sheet-ready", onSheetReady);
</script>

