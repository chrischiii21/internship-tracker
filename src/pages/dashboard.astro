---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { getSession } from '../lib/auth';
import { parse } from 'cookie';
import { getAppSettings, DEFAULT_SETTINGS } from '../lib/settings';
import { getTrackedEntries, getActiveTimer } from '../lib/entries';
import { getStudentProgress } from '../lib/clockify';
import { formatHMS, formatHours, manilaDate } from '../lib/utils';
import { groupEntries } from '../lib/grouping';
import { totalEarnings, totalDaysWorked, buildPeriodBreakdown } from '../lib/earnings';
import { getPayoutAdjustments } from '../lib/payouts';

const cookieHeader = Astro.request.headers.get('cookie') || '';
const cookies = parse(cookieHeader);
const user = cookies.session ? await getSession(cookies.session) : null;

if (!user) {
  return Astro.redirect('/');
}

const settings = await getAppSettings(user.id);
const todayStr = manilaDate();
const setupStartDate = (!settings.startDate || settings.startDate === DEFAULT_SETTINGS.startDate) ? todayStr : settings.startDate;

// Role-based redirect. The header's tour button sends every page here, so carry the request
// across to the coordinator's own walkthrough instead of dropping it.
if (settings.role === 'coordinator') {
  return Astro.redirect(Astro.url.searchParams.get('tour') ? '/coordinator?tour=1' : '/coordinator');
}

const activeStartDate = settings.isEmployee ? (settings.employeeStartDate || settings.startDate) : settings.startDate;
const activePaySchedule = settings.isEmployee ? (settings.employeePaySchedule || 'monthly') : settings.paySchedule;
const activeCompany = settings.isEmployee ? (settings.employerCompany || settings.hostCompany) : settings.hostCompany;

// Calculate Total Progress using the Unified Sync Engine
let renderedHours = await getStudentProgress(user.id, user.email, activeStartDate, settings.isEmployee);

// Everything that counts toward hours: synced Clockify sessions plus entries logged here.
const allRawEntries = await getTrackedEntries(user.id, user.email, settings, activeStartDate);

// A session that is still running lives in active_timers and only becomes an `entries` row on
// time-out — so without this every figure below reads zero for today while you are clocked in.
// Counted against its start date, the same day stopTimer will file it under.
const liveTimer = await getActiveTimer(user.id, settings.isEmployee ?? false);
let liveSeconds = 0;
let liveDateStr = '';
if (liveTimer) {
  const liveStart = new Date(liveTimer.startTime);
  liveSeconds = Math.max(0, Math.floor((Date.now() - liveStart.getTime()) / 1000));
  liveDateStr = manilaDate(liveStart);
  allRawEntries.push({ date: liveDateStr, durationSeconds: liveSeconds });
  renderedHours += liveSeconds / 3600;
}

const dailyHoursMap: Record<string, number> = {};
allRawEntries.forEach(e => {
  dailyHoursMap[e.date] = (dailyHoursMap[e.date] || 0) + e.durationSeconds / 3600;
});
const todayManila = manilaDate();
// Anchored at UTC midnight of the Manila date, so day arithmetic stays on the same calendar days
// the entry keys use.
const manilaDayOffset = (n: number) => {
  const d = new Date(`${todayManila}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + n);
  return d;
};
// Rolling 7-day total, kept only for the recent-pace badge — the tile that used to show it was
// redundant with the Weekly Activity card below.
const totalWeekHours = Array.from({ length: 7 }, (_, i) =>
  dailyHoursMap[manilaDayOffset(-i).toISOString().split('T')[0]] || 0
).reduce((sum, h) => sum + h, 0);

// Today's running total: everything already closed today plus the session still ticking. The
// closed part is what the client ticker counts up from, so it never double-counts the live one.
const todaySeconds = Math.round((dailyHoursMap[todayManila] || 0) * 3600);
// A timer started before midnight belongs to yesterday (that is the day stopTimer files it under),
// so it neither ticks here nor gets subtracted from today's base.
const liveStartedToday = !!liveTimer && manilaDate(new Date(liveTimer.startTime)) === todayManila;
const todayClosedSeconds = Math.max(0, todaySeconds - (liveStartedToday ? liveSeconds : 0));
const todayEntryCount = allRawEntries.filter(e => e.date === todayManila).length - (liveStartedToday ? 1 : 0);

// Weekly totals for real Mon-Sun calendar weeks that overlap the current month — a week counts as
// one block even when it straddles the month boundary, instead of getting cut off at the 1st.
const isoWeekdayOf = (dateStr: string) => {
  const wd = new Date(`${dateStr}T00:00:00Z`).getUTCDay();
  return wd === 0 ? 7 : wd; // 1=Mon..7=Sun
};
const shortDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

const mondayThisWeekStr = manilaDayOffset(-(isoWeekdayOf(todayManila) - 1)).toISOString().split('T')[0];
const monthStartStr = `${todayManila.slice(0, 7)}-01`;
const mondayOfMonthStart = (() => {
  const d = new Date(`${monthStartStr}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() - (isoWeekdayOf(monthStartStr) - 1));
  return d;
})();
const [todayYearNum, todayMonthNum] = todayManila.split('-').map(Number);
const daysInMonth = new Date(Date.UTC(todayYearNum, todayMonthNum, 0)).getUTCDate();
const monthEndStr = `${todayManila.slice(0, 7)}-${String(daysInMonth).padStart(2, '0')}`;
const mondayOfMonthEnd = (() => {
  const d = new Date(`${monthEndStr}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() - (isoWeekdayOf(monthEndStr) - 1));
  return d;
})();
// Full month up front, so a week that hasn't happened yet shows as an empty row instead of not
// existing at all.
const weeksCount = Math.round((mondayOfMonthEnd.getTime() - mondayOfMonthStart.getTime()) / (7 * 86400000)) + 1;

const monthWeeksData: { label: string, from: string, to: string, isCurrent: boolean, days: number, hours: number }[] =
  Array.from({ length: weeksCount }, (_, i) => {
    const start = new Date(mondayOfMonthStart);
    start.setUTCDate(start.getUTCDate() + i * 7);
    const end = new Date(start);
    end.setUTCDate(end.getUTCDate() + 6);
    const from = start.toISOString().split('T')[0];
    return {
      label: `${shortDate(start)} – ${shortDate(end)}`,
      from,
      to: end.toISOString().split('T')[0],
      isCurrent: from === mondayThisWeekStr,
      days: 0,
      hours: 0,
    };
  });

// Weekly Activity only counts a session once it's stopped — a running timer keeps ticking on
// the Today tile, but shouldn't inflate this week's row until it lands as a closed entry.
Object.entries(dailyHoursMap).forEach(([d, h]) => {
  const week = monthWeeksData.find(w => d >= w.from && d <= w.to);
  if (!week) return;
  const closedH = d === liveDateStr ? Math.max(0, h - liveSeconds / 3600) : h;
  week.hours += closedH;
  if (closedH > 0) week.days++;
});
const maxWeekHours = Math.max(1, ...monthWeeksData.map(w => w.hours));
const bestDayHours = Math.max(0, ...Object.values(dailyHoursMap));

let currentStreak = 0;
for (let i = 0; i < 3650; i++) {
  const dateStr = manilaDayOffset(-i).toISOString().split('T')[0];
  if ((dailyHoursMap[dateStr] || 0) > 0) currentStreak++;
  else break;
}

// Period breakdown behind the earnings tile — the full list opens in a modal from the tile, so
// there's no separate page to keep in step.
const isEarningsMode = !!(settings.hasAllowance || settings.isEmployee);
const earningsGroups = groupEntries(allRawEntries, isEarningsMode ? activePaySchedule : 'monthly');
const payoutAdjustments = isEarningsMode ? await getPayoutAdjustments(user.id) : {};
const periodRows = buildPeriodBreakdown(settings, earningsGroups, payoutAdjustments).reverse();

const quickEarnings = isEarningsMode ? totalEarnings(settings, earningsGroups) : 0;
const quickEarningsPeriods = earningsGroups.length;
const quickEarningsDays = totalDaysWorked(earningsGroups);
const quickEarningsHours = earningsGroups.reduce((sum, group) => sum + group.totalSeconds, 0) / 3600;
const quickEarningsRate = settings.isEmployee
  ? (activePaySchedule === 'semi-monthly' ? (settings.monthlyRate || 0) / 2 : (settings.monthlyRate || 0))
  : settings.hourlyRate;

// All-time activity stats: active day count, longest consecutive streak, average pace, this-month total
const activeDates = Object.keys(dailyHoursMap).filter(d => dailyHoursMap[d] > 0).sort();
const activeDaysCount = activeDates.length;
let longestStreak = 0;
{
  let run = 0;
  let prevTime = 0;
  for (const dateStr of activeDates) {
    const t = new Date(dateStr).getTime();
    run = (prevTime && t - prevTime === 86400000) ? run + 1 : 1;
    longestStreak = Math.max(longestStreak, run);
    prevTime = t;
  }
}

const daysSinceStart = Math.max(1, Math.ceil((new Date().getTime() - new Date(activeStartDate).getTime()) / 86400000));
const avgHoursPerDayOverall = renderedHours / daysSinceStart;

const currentMonthPrefix = todayManila.slice(0, 7);
const hoursThisMonth = Object.entries(dailyHoursMap)
  .filter(([d]) => d.startsWith(currentMonthPrefix))
  .reduce((sum, [, h]) => sum + h, 0);

// Hours per week from program start to today — the total logged inside each week, not a running
// total, so a slow week reads as a dip instead of a flatter climb. Weeks are 7-day blocks from the
// start date; the last one is short whenever today lands mid-week.
// (ponytail: window capped defensively against a bad/very old start date, not a real-world case.)
const CHART_MAX_WEEKS = 104;
const chartToday = new Date(`${todayManila}T00:00:00Z`);
const chartTrueStart = new Date(`${activeStartDate}T00:00:00Z`);
const chartTotalSpanDays = Math.max(1, Math.floor((chartToday.getTime() - chartTrueStart.getTime()) / 86400000) + 1);

const chartDayLabel = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const weekSeries = Array.from({ length: Math.ceil(chartTotalSpanDays / 7) }, (_, w) => {
  const start = new Date(chartTrueStart);
  start.setUTCDate(start.getUTCDate() + w * 7);
  const end = new Date(start);
  end.setUTCDate(end.getUTCDate() + 6);
  if (end > chartToday) end.setTime(chartToday.getTime());

  let hours = 0;
  for (let c = new Date(start); c <= end; c.setUTCDate(c.getUTCDate() + 1)) {
    hours += dailyHoursMap[c.toISOString().split('T')[0]] || 0;
  }
  return { date: end.toISOString().split('T')[0], label: `${chartDayLabel(start)} – ${chartDayLabel(end)}`, hours };
}).slice(-CHART_MAX_WEEKS);

const CHART_W = 720;
const CHART_H = 220;
const CHART_PAD = { top: 16, right: 16, bottom: 26, left: 46 };
const chartPlotW = CHART_W - CHART_PAD.left - CHART_PAD.right;
const chartPlotH = CHART_H - CHART_PAD.top - CHART_PAD.bottom;

// The cumulative target line went with the cumulative series — a 486h goal drawn against ~40h
// weeks would flatten the whole chart. Progress against target still lives in the cards above.
const weekMaxHours = Math.max(0, ...weekSeries.map(w => w.hours));
const chartMaxY = (weekMaxHours * 1.15) || 1;

const chartX = (i: number) => weekSeries.length > 1 ? CHART_PAD.left + (i / (weekSeries.length - 1)) * chartPlotW : CHART_PAD.left + chartPlotW / 2;
const chartY = (v: number) => CHART_PAD.top + (1 - v / chartMaxY) * chartPlotH;

const chartPoints = weekSeries.map((d, i) => ({ x: chartX(i), y: chartY(d.hours), date: d.label, hours: d.hours.toFixed(1) }));
const linePath = chartPoints.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const areaPath = chartPoints.length > 0
  ? `${chartX(0).toFixed(1)},${chartY(0).toFixed(1)} ${linePath} ${chartX(weekSeries.length - 1).toFixed(1)},${chartY(0).toFixed(1)}`
  : '';
const chartYTicks = [0, chartMaxY / 2, chartMaxY];
const avgWeekHours = weekSeries.reduce((sum, w) => sum + w.hours, 0) / (weekSeries.length || 1);
const chartAvgY = chartY(avgWeekHours);
const chartLastPoint = chartPoints[chartPoints.length - 1];

const progressPercent = settings.isEmployee ? 0 : Math.min(100, (renderedHours / (settings.targetHours || 1)) * 100);

// Calculate Estimated Finish Date
let finishDateStr = '';
if (!settings.isEmployee) {
  const remainingHours = Math.max(0, settings.targetHours - renderedHours);
  let avgHoursPerDay = 8; // Default

  if (allRawEntries.length > 0) {
    // Calculate average from last 7 unique days of logs
    const dailyTotals: Record<string, number> = {};
    allRawEntries.forEach(e => {
      dailyTotals[e.date] = (dailyTotals[e.date] || 0) + (e.durationSeconds / 3600);
    });
    const recentDays = Object.values(dailyTotals).slice(-7);
    if (recentDays.length > 0) {
      avgHoursPerDay = recentDays.reduce((a, b) => a + b, 0) / recentDays.length;
      if (avgHoursPerDay < 1) avgHoursPerDay = 8; // Fallback if average is too low
    }
  }

  const workDaysRemaining = Math.ceil(remainingHours / avgHoursPerDay);
  let estimatedFinishDate = new Date();
  let daysAdded = 0;
  while (daysAdded < workDaysRemaining) {
    estimatedFinishDate.setDate(estimatedFinishDate.getDate() + 1);
    // Skip weekends (0 is Sunday, 6 is Saturday)
    if (estimatedFinishDate.getDay() !== 0 && estimatedFinishDate.getDay() !== 6) {
      daysAdded++;
    }
  }

  finishDateStr = estimatedFinishDate.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
}

// Pace badge: recent 7-day average vs overall average since start
let paceStatus = '';
let recentAvgHours = 0;
if (!settings.isEmployee) {
  recentAvgHours = totalWeekHours / 7;
  paceStatus = recentAvgHours >= avgHoursPerDayOverall ? 'ahead' : 'behind';
}
---

<Layout title="Dashboard">
  <!-- How It Works Modal (Student) -->
  <div id="how-it-works-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content info-modal-content">
      <div class="modal-header-info">
        <div class="info-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        </div>
        <h3>How OJT Portal Works</h3>
      </div>
      <p class="modal-subtitle">Welcome! Here is a quick guide on how to track your hours and verify your progress.</p>
      
      <div class="guide-steps">
        <div class="guide-step">
          <span class="step-num">1</span>
          <div class="step-details">
            <h4>Connect with Coordinator (Optional)</h4>
            <p>Linking with a coordinator is optional. If your coordinator reaches out, you can easily connect later in <strong>Settings</strong> using their invite code.</p>
          </div>
        </div>
        <div class="guide-step">
          <span class="step-num">2</span>
          <div class="step-details">
            <h4>Track OJT Hours</h4>
            <p>Use the <strong>Time In / Time Out</strong> button in the header for live sessions, or log manual entries in the <strong>Tracker</strong> tab. The badge beside it tells you whether <strong>Clockify</strong> is syncing too, or you're on the built-in timer alone.</p>
          </div>
        </div>
        <div class="guide-step">
          <span class="step-num">3</span>
          <div class="step-details">
            <h4>Upload Documentation</h4>
            <p>Always upload image proof (screenshots of work or activity photos) when adding/editing manual entries to ensure coordinator approval.</p>
          </div>
        </div>
        <div class="guide-step">
          <span class="step-num">4</span>
          <div class="step-details">
            <h4>Monitor Allowances (Optional)</h4>
            <p>If your internship includes a stipend, you can enable and track your pending earnings and payouts in the <strong>Settings</strong> panel.</p>
          </div>
        </div>
      </div>
      
      <div class="modal-actions-single">
        <button type="button" class="btn-onboarding" onclick="document.getElementById('how-it-works-modal').style.display='none'">Got it, let's start!</button>
      </div>
    </div>
  </div>

  <!-- Period breakdown: the old Earnings page, opened from the tile above instead of its own tab -->
  <div id="breakdown-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content breakdown-modal-content">
      <div class="breakdown-header">
        <div>
          <h3>{isEarningsMode ? 'Earnings' : 'Hours'} Breakdown</h3>
          <p class="modal-subtitle">
            {isEarningsMode
              ? 'Expected pay and payout status for each period.'
              : 'Your logged hours grouped by month.'}
          </p>
        </div>
        <button type="button" id="breakdown-close" class="breakdown-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      {isEarningsMode && (
        <div class="breakdown-total">
          <span>Total Expected</span>
          <strong id="breakdown-total-value">₱ {quickEarnings.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong>
        </div>
      )}

      <div id="breakdown-list" class="breakdown-list">
        {periodRows.map(row => (
          <div class="bd-row" data-label={row.label}>
            <div class="bd-main">
              <span class="bd-label">{row.label}</span>
              <span class="bd-meta">
                {!settings.isEmployee && settings.payType === 'daily' && isEarningsMode
                  ? `${row.daysWorked} ${row.daysWorked === 1 ? 'day' : 'days'} worked · ${formatHours(row.rendered)}`
                  : `${formatHours(row.rendered)} tracked`}
                {row.carryOverIn !== 0 && isEarningsMode && (
                  <span class={`bd-carry ${row.carryOverIn > 0 ? 'plus' : 'minus'}`}>
                    {row.carryOverIn > 0 ? '+' : ''}₱{row.carryOverIn.toLocaleString('en-US', { maximumFractionDigits: 2 })} carry-over
                  </span>
                )}
              </span>
            </div>

            {isEarningsMode ? (
              <div class="bd-values">
                <div class="bd-amount-group">
                  <span class="bd-amount-label">{row.isAdjusted ? 'Received' : 'Expected'}</span>
                  <span class={`bd-amount ${row.isAdjusted ? 'received' : ''}`}>
                    ₱ {(row.isAdjusted ? row.actualReceived : row.totalExpected).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                  </span>
                </div>
                <div class="bd-actions">
                  {!row.isAdjusted && (
                    <button type="button" class="bd-btn-received" data-amount={row.totalExpected.toFixed(2)}>Received</button>
                  )}
                  <button type="button" class="bd-btn-edit" data-amount={(row.isAdjusted ? row.actualReceived : row.totalExpected).toFixed(2)}>Edit</button>
                </div>
                <div class="bd-edit" style="display: none;">
                  <span class="bd-currency">₱</span>
                  <input type="number" step="0.01" class="bd-edit-input" value={(row.isAdjusted ? row.actualReceived : row.totalExpected).toFixed(2)} />
                  <button type="button" class="bd-btn-save">Save</button>
                  <button type="button" class="bd-btn-cancel">Cancel</button>
                </div>
              </div>
            ) : (
              <div class="bd-values">
                <div class="bd-amount-group">
                  <span class="bd-amount-label">Rendered</span>
                  <span class="bd-amount">{formatHours(row.rendered)}</span>
                </div>
              </div>
            )}
          </div>
        ))}
        {periodRows.length === 0 && (
          <div class="bd-empty">No logs recorded for the current period yet.</div>
        )}
      </div>
    </div>
  </div>

  <Header user={user} />
  
  <div id="portal-body">
    <Sidebar user={user} activeTab="dashboard" role={settings.role} />
    
    <main id="portal-main">
      <div class="bg-grid" aria-hidden="true"></div>

      {settings.setupComplete === false && (
        <div id="setup-wizard-overlay" class="modal-overlay">
          <div class="setup-card">
            <div class="setup-header">
              <h2>Welcome to <span class="accent">InternFlow</span></h2>
              <p>Let's get your profile set up to start tracking your progress.</p>
            </div>
            
            <form action="/api/settings" method="POST" class="setup-form">
              <input type="hidden" name="setupComplete" value="true" />
              <input type="hidden" name="redirect" value="/dashboard" />
              <input type="hidden" name="inviteCode" id="generated-invite" value="" />
              
              <div class="role-selector">
                <label class="role-option">
                  <input type="radio" name="role" value="student" checked />
                  <div class="role-content">
                    <span class="role-title">I am a Student</span>
                    <span class="role-desc">Track OJT hours and manage allowance.</span>
                  </div>
                </label>
                <label class="role-option">
                  <input type="radio" name="role" value="coordinator" />
                  <div class="role-content">
                    <span class="role-title">I am a Coordinator</span>
                    <span class="role-desc">Manage students and monitor their progress.</span>
                  </div>
                </label>
              </div>

              <div id="student-fields" class="setup-grid">
                <div class="setup-row">
                  <div class="form-group">
                    <label>Coordinator Invite Code (Optional)</label>
                    <input type="text" name="coordinatorInvite" placeholder="Enter 6-char code" class="setup-input" />
                  </div>
                  <div class="form-group">
                    <label>Cooperating Agency / Company</label>
                    <input type="text" name="hostCompany" placeholder="Company Name" class="setup-input" />
                  </div>
                </div>

                <div class="setup-row">
                  <div class="form-group">
                    <label>Internship Program</label>
                    <input type="text" name="program" placeholder="e.g. BS Information Technology" class="setup-input" />
                  </div>
                  <div class="form-group">
                    <label>Supervisor Name</label>
                    <input type="text" name="supervisor" placeholder="Full Name" class="setup-input" />
                  </div>
                </div>

                <div class="setup-row">
                  <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" name="startDate" value={setupStartDate} required />
                  </div>
                  <div class="form-group">
                    <label>Target Hours</label>
                    <input type="number" name="targetHours" value={settings.targetHours} required />
                  </div>
                </div>

                <div class="allowance-section-setup">
                  <div class="form-group mb-0">
                    <label class="check-label-setup">
                      <input type="checkbox" name="hasAllowance" value="true" checked id="allowance-toggle-setup" />
                      <span class="toggle-text">Enable Allowance Tracking</span>
                    </label>
                  </div>
                  
                  <div id="allowance-fields-setup" class="allowance-fields-grid">
                    <div class="setup-row">
                      <div class="form-group">
                        <label>Pay Model</label>
                        <select name="payType" class="setup-select">
                          <option value="hourly">Hourly Rate</option>
                          <option value="daily">Fixed Daily Rate</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label>Rate (₱)</label>
                        <input type="number" name="hourlyRate" value={settings.hourlyRate} />
                      </div>
                    </div>
                    <div class="form-group">
                      <label>Pay Schedule</label>
                      <select name="paySchedule" class="setup-select">
                        <option value="weekly">Weekly</option>
                        <option value="semi-monthly">Semi-monthly (15/30)</option>
                        <option value="monthly" selected>Monthly</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <div id="coordinator-fields" style="display: none;">
                <div class="info-note">
                  <p>As a coordinator, you'll manage your students via a custom dashboard and unique invite code.</p>
                </div>
              </div>
              
              <button type="submit" class="btn-setup">Save & Initialize Dashboard</button>
            </form>

            <script is:inline>
              const roleRadios = document.querySelectorAll('input[name="role"]');
              const studentFields = document.getElementById('student-fields');
              const coordinatorFields = document.getElementById('coordinator-fields');
              const inviteInput = document.getElementById('generated-invite');
              const allowanceToggle = document.getElementById('allowance-toggle-setup');
              const allowanceFields = document.getElementById('allowance-fields-setup');

              allowanceToggle?.addEventListener('change', (e) => {
                if (allowanceFields) allowanceFields.style.display = e.target.checked ? 'block' : 'none';
              });

              roleRadios.forEach(radio => {
                radio.addEventListener('change', (e) => {
                  if (e.target.value === 'coordinator') {
                    studentFields.style.display = 'none';
                    coordinatorFields.style.display = 'block';
                    if (!inviteInput.value) {
                      inviteInput.value = Math.random().toString(36).substring(2, 8).toUpperCase();
                    }
                    studentFields.querySelectorAll('input[required]').forEach(i => i.required = false);
                  } else {
                    studentFields.style.display = 'grid';
                    coordinatorFields.style.display = 'none';
                    studentFields.querySelectorAll('input').forEach(i => {
                       if (i.name !== 'coordinatorInvite' && i.name !== 'hasAllowance' && !allowanceFields?.contains(i)) i.required = true;
                    });
                  }
                });
              });

              // Dynamically set redirect target with firstLogin flag depending on selected role
              const setupForm = document.querySelector('.setup-form');
              const redirectInput = setupForm?.querySelector('input[name="redirect"]');
              setupForm?.addEventListener('submit', () => {
                const selectedRole = document.querySelector('input[name="role"]:checked')?.value;
                if (redirectInput) {
                  if (selectedRole === 'coordinator') {
                    redirectInput.value = '/coordinator?firstLogin=true';
                  } else {
                    redirectInput.value = '/dashboard?firstLogin=true';
                  }
                }
              });
            </script>
          </div>
        </div>
      )}



      <div id="dash-content" class="content-center">
        <div class="dashboard-header">
          <div class="header-main">
            <h1>Welcome back, <span class="accent">{user.name}</span></h1>
            <p>{settings.isEmployee ? "Here's your time tracking dashboard and pay logs." : "Here's your current internship status and progress tracker."}</p>
          </div>
          <div class="header-date">
            <span class="date-label">TODAY</span>
            <span class="date-value">{new Date(`${todayManila}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</span>
          </div>
        </div>

        <div class="metrics-grid">
          {settings.isEmployee ? (
            <>
              <div class="metric-card" style="justify-content: center; height: 100%; min-height: 180px;">
                <div class="metric-info">
                  <span class="metric-label">Total Time Tracked</span>
                  <div class="metric-value" style="font-size: 36px;">{formatHours(renderedHours)}</div>
                  <span class="metric-subtext" style="margin-top: 4px; display: block; font-size: 13px; color: var(--text-secondary);">
                    Active session hours logged in your system.
                  </span>
                </div>
                <div class="hero-substats">
                  <div class="hero-substat">
                    <span class="hero-substat-label">Avg / Day</span>
                    <span class="hero-substat-value">{avgHoursPerDayOverall.toFixed(1)}h</span>
                  </div>
                  <div class="hero-substat">
                    <span class="hero-substat-label">This Month</span>
                    <span class="hero-substat-value">{formatHours(hoursThisMonth)}</span>
                  </div>
                  <div class="hero-substat">
                    <span class="hero-substat-label">Active Days</span>
                    <span class="hero-substat-value">{activeDaysCount}</span>
                  </div>
                </div>
              </div>

              <div class="metric-card company-summary">
                <div class="company-header-mini">
                  <div class="company-info-mini">
                    <span class="metric-label">Employment Details</span>
                    <div class="metric-value-mini text-truncate">{activeCompany || 'Not set'}</div>
                  </div>
                </div>
                <div class="company-quick-details">
                  <div class="quick-row">
                    <span class="q-label">Employment Type:</span>
                    <span class="q-value">Full-time / Personal Tracker</span>
                  </div>
                  <div class="quick-row">
                    <span class="q-label">Monthly Rate:</span>
                    <span class="q-value">₱{settings.monthlyRate?.toLocaleString()} / month</span>
                  </div>
                  <div class="quick-row">
                    <span class="q-label">Pay Schedule:</span>
                    <span class="q-value">{activePaySchedule === 'semi-monthly' ? 'Every 15 days (Semi-monthly)' : 'Monthly'}</span>
                  </div>
                  <div class="quick-row">
                    <span class="q-label">Start Date:</span>
                    <span class="q-value">{activeStartDate}</span>
                  </div>
                </div>
              </div>
            </>
          ) : (
            <>
              <div class="metrics-column">
                <div class="metric-card">
                  <div class="metric-info">
                    <span class="metric-label">Hours Rendered</span>
                    <div class="metric-value">{formatHours(renderedHours)} <span class="unit">/ {formatHours(settings.targetHours)}</span></div>
                  </div>
                  <div class="metric-progress">
                    <div class={`progress-fill ${progressPercent >= 100 ? 'success' : ''}`} style={`width: ${progressPercent}%`}></div>
                  </div>
                  <div class="progress-status">
                    <span>{progressPercent >= 100 ? 'Completed' : 'In Progress'}</span>
                    <span class="percent-val">{progressPercent.toFixed(2)}%</span>
                  </div>
                </div>

                <div class={`metric-card highlight-card ${renderedHours > settings.targetHours ? 'overtime' : ''}`}>
                  <div class="metric-info">
                    <span class="metric-label">{renderedHours > settings.targetHours ? 'Excess Time' : 'Remaining Time'}</span>
                    <div class="metric-value">
                      {renderedHours > settings.targetHours ? '+' : ''}
                      {formatHMS(Math.abs((settings.targetHours * 3600) - (renderedHours * 3600)))}
                    </div>
                    <span class="metric-subtext">
                      {renderedHours >= settings.targetHours
                        ? 'Goal reached! Every hour now is extra credit.'
                        : `Est. Finish: ${finishDateStr}`}
                    </span>
                    {renderedHours < settings.targetHours && (
                      <span class={`pace-badge ${paceStatus}`}>
                        {paceStatus === 'ahead' ? '↑' : '↓'} {recentAvgHours.toFixed(1)}h/day recent pace
                      </span>
                    )}
                  </div>
                </div>
              </div>

              <div class="metric-card company-summary">
                <div class="company-header-mini">
                  <div class="company-info-mini">
                    <span class="metric-label">Internship Configuration</span>
                    <div class="metric-value-mini text-truncate">{settings.hostCompany || 'Not set'}</div>
                  </div>
                </div>
                <div class="company-quick-details">
                  <div class="quick-row">
                    <span class="q-label">Program:</span>
                    <span class="q-value">{settings.program || 'Not set'}</span>
                  </div>
                  <div class="quick-row">
                    <span class="q-label">Allowance:</span>
                    <span class="q-value">{settings.hasAllowance ? 'Enabled' : 'Disabled'}</span>
                  </div>
                  {settings.hasAllowance && (
                    <>
                      <div class="quick-row">
                        <span class="q-label">Pay Model:</span>
                        <span class="q-value">{settings.payType === 'hourly' ? 'Hourly' : 'Daily'}</span>
                      </div>
                      <div class="quick-row">
                        <span class="q-label">Rate:</span>
                        <span class="q-value">₱{settings.hourlyRate}/{settings.payType === 'hourly' ? 'hr' : 'day'}</span>
                      </div>
                      <div class="quick-row">
                        <span class="q-label">Schedule:</span>
                        <span class="q-value">{settings.paySchedule}</span>
                      </div>
                    </>
                  )}
                </div>
              </div>
            </>
          )}
        </div>

        <div class="quick-stats">
          <div class="stat-tile">
            <div class="stat-head">
              <span class="stat-label">Today</span>
              <span
                class="stat-value"
                id="today-total"
                data-closed={todayClosedSeconds}
                data-live-start={liveStartedToday ? liveTimer!.startTime : ''}
              >{formatHMS(todaySeconds)}</span>
            </div>
            <p class="stat-explain">
              {liveStartedToday
                ? `Counting up live — ${todayEntryCount} closed ${todayEntryCount === 1 ? 'entry' : 'entries'} today plus the session running now.`
                : `${todayEntryCount} ${todayEntryCount === 1 ? 'entry' : 'entries'} logged today. Time In from the header to start counting.`}
            </p>
          </div>
          <script is:inline>
            // Keeps the Today tile ticking while a session is open. Time In/Out reloads the page,
            // so the closed base below is never stale.
            {
              const el = document.getElementById('today-total');
              const startedAt = el && el.dataset.liveStart ? new Date(el.dataset.liveStart).getTime() : null;
              if (startedAt) {
                const closed = Number(el.dataset.closed) || 0;
                const pad = (n) => String(n).padStart(2, '0');
                const tick = () => {
                  const t = closed + Math.max(0, Math.floor((Date.now() - startedAt) / 1000));
                  el.textContent = `${pad(Math.floor(t / 3600))}:${pad(Math.floor((t % 3600) / 60))}:${pad(t % 60)}`;
                };
                tick();
                setInterval(tick, 1000);
              }
            }
          </script>

          <div class="stat-tile">
            <div class="stat-head">
              <span class="stat-label">Streak</span>
              <span class="stat-value">{currentStreak} {currentStreak === 1 ? 'day' : 'days'}</span>
            </div>
            <p class="stat-explain">
              Consecutive days with at least one log, counting back from today. Your best run since {activeStartDate} was {longestStreak} {longestStreak === 1 ? 'day' : 'days'}.
            </p>
          </div>

          <div class="stat-tile">
            <div class="stat-head">
              <span class="stat-label">Total Logs</span>
              <span class="stat-value">{allRawEntries.length}</span>
            </div>
            <p class="stat-explain">
              {allRawEntries.length} time entries recorded since {activeStartDate}, across {activeDaysCount} active days — combines synced sessions and manual entries.
            </p>
          </div>

          {isEarningsMode ? (
            <div class="stat-tile" data-tour="earnings-tile">
              <div class="stat-head">
                <span class="stat-label">Expected Earnings</span>
                <span class="stat-value">₱{quickEarnings.toLocaleString('en-US', { maximumFractionDigits: 0 })}</span>
              </div>
              <p class="stat-explain">
                {settings.isEmployee
                  ? `${quickEarningsPeriods} pay period(s) × ₱${quickEarningsRate.toLocaleString()} on your ${activePaySchedule} schedule.`
                  : settings.payType === 'daily'
                    ? `${quickEarningsDays} day(s) worked × ₱${settings.hourlyRate}/day.`
                    : `${formatHours(quickEarningsHours)} tracked × ₱${settings.hourlyRate}/hr.`}
                {' '}<button type="button" class="stat-explain-link open-breakdown">View full breakdown →</button>
              </p>
            </div>
          ) : (
            <div class="stat-tile" data-tour="earnings-tile">
              <div class="stat-head">
                <span class="stat-label">Best Day</span>
                <span class="stat-value">{formatHours(bestDayHours)}</span>
              </div>
              <p class="stat-explain">
                Your single best day out of {activeDaysCount} active day(s) logged so far.
                {' '}<button type="button" class="stat-explain-link open-breakdown">Monthly breakdown →</button>
              </p>
            </div>
          )}
        </div>

        <div class="full-grid">
          <section class="weekly-chart-card">
            <div class="section-header">
              <h2>Weekly <span class="accent">Activity</span></h2>
              <span class="chart-total">{formatHours(hoursThisMonth)} this month</span>
            </div>
            <div class="week-rows">
              {monthWeeksData.map(w => (
                <div class={`week-row ${w.isCurrent ? 'current' : ''}`}>
                  <div class="week-range">
                    <span>{w.label}</span>
                    {w.isCurrent && <span class="week-now">this week</span>}
                  </div>
                  <div class="week-track">
                    <div class={`week-fill ${w.hours > 0 ? 'has-hours' : ''}`} style={`width: ${(w.hours / maxWeekHours) * 100}%`}></div>
                  </div>
                  <div class="week-figures">
                    <span class="week-hours">{formatHours(w.hours)}</span>
                    <span class="week-days">{w.days} {w.days === 1 ? 'day' : 'days'}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <section class="progress-chart-card">
            <div class="section-header">
              <h2>Progress <span class="accent">Trend</span></h2>
              <div class="chart-legend">
                <span class="legend-item"><span class="legend-swatch line"></span>Hours / Week</span>
                <span class="legend-item"><span class="legend-swatch target"></span>Avg {avgWeekHours.toFixed(1)}h</span>
              </div>
            </div>

            {chartPoints.length > 1 ? (
              <div class="progress-chart-wrap">
                <svg
                  id="progress-chart-svg"
                  class="progress-chart"
                  viewBox={`0 0 ${CHART_W} ${CHART_H}`}
                  preserveAspectRatio="none"
                  data-pad-left={CHART_PAD.left}
                  data-plot-w={chartPlotW}
                >
                  {chartYTicks.map(t => (
                    <>
                      <line class="chart-gridline" x1={CHART_PAD.left} x2={CHART_W - CHART_PAD.right} y1={chartY(t)} y2={chartY(t)} />
                      <text class="chart-axis-label" x={CHART_PAD.left - 8} y={chartY(t)} text-anchor="end" dominant-baseline="middle">{Math.round(t)}h</text>
                    </>
                  ))}

                  <line class="chart-target-line" x1={CHART_PAD.left} x2={CHART_W - CHART_PAD.right} y1={chartAvgY} y2={chartAvgY} />

                  <polygon class="chart-area" points={areaPath} />
                  <polyline class="chart-line" points={linePath} />

                  {chartLastPoint && <circle class="chart-end-dot" cx={chartLastPoint.x} cy={chartLastPoint.y} r="4.5" />}
                  {chartLastPoint && (
                    <text class="chart-end-label" x={chartLastPoint.x} y={chartLastPoint.y - 10} text-anchor="end">{chartLastPoint.hours}h</text>
                  )}

                  <text class="chart-axis-label" x={CHART_PAD.left} y={CHART_H - 6} text-anchor="start">{weekSeries[0].label}</text>
                  <text class="chart-axis-label" x={CHART_W - CHART_PAD.right} y={CHART_H - 6} text-anchor="end">{weekSeries[weekSeries.length - 1].label}</text>

                  <line id="progress-chart-crosshair" class="chart-crosshair" x1="0" x2="0" y1={CHART_PAD.top} y2={CHART_H - CHART_PAD.bottom} />
                  <circle id="progress-chart-hover-dot" class="chart-hover-dot" r="5" />
                </svg>
                <div id="progress-chart-tooltip" class="chart-tooltip">
                  <span class="tt-value"></span>
                  <span class="tt-date"></span>
                </div>
              </div>
              <script type="application/json" id="progress-chart-data" is:inline set:html={JSON.stringify(chartPoints)} />
            ) : (
              <p class="chart-empty">Keep logging — your weekly trend shows up here once you have a second week.</p>
            )}
          </section>
        </div>
      </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const params = new URLSearchParams(window.location.search);
  
  // Show How It Works modal if firstLogin param is true and not seen yet
  const isFirstLogin = params.get('firstLogin') === 'true';
  const hasSeenOnboarding = localStorage.getItem('has_seen_onboarding_student');
  const worksModal = document.getElementById('how-it-works-modal');
  const showedIntroModal = isFirstLogin && !hasSeenOnboarding;

  if (showedIntroModal && worksModal) {
    worksModal.style.display = 'flex';
  }

  // Guided walkthrough of the whole app. Registering it also arms the header's tour button,
  // which replays these steps on demand.
  const dashboardTourSteps = [
    {
      target: '[data-tour="nav-dashboard"]',
      title: "You're on the Dashboard",
      body: 'This is your home base: hours rendered, time remaining, streaks and progress charts, all built from the sessions you log.',
    },
    {
      target: '.metrics-grid',
      title: 'Progress at a glance',
      body: 'Total hours against your target, plus how much time is left and an estimated finish date based on your recent pace.',
    },
    {
      target: '[data-tour="earnings-tile"]',
      title: 'Earnings, without leaving the page',
      body: 'This tile shows what your logged hours are worth. Open the full breakdown to see each pay period, mark a payout as received, or correct an amount — it all happens right here.',
    },
    {
      target: '.quick-stats',
      title: 'Quick stats',
      body: 'The running total for today, streaks, total logs and expected earnings — each tile spells out how its number was worked out, so nothing here is a black box.',
    },
    {
      target: '.weekly-chart-card',
      title: 'Weekly activity',
      body: 'Hours grouped by week for the current month, so a light week is obvious before it becomes a problem.',
    },
    {
      target: '.progress-chart-card',
      title: 'Progress trend',
      body: 'Hours logged in each week against your average week — a light week dips instead of just flattening. Hover or drag across it to read any week.',
    },
    {
      target: '#clock-toggle-wrap',
      title: 'Time In / Time Out',
      body: 'Start a live session with Time In and close it with Time Out — the timer keeps running even if you close the tab. The pencil corrects a start time you punched in late.',
    },
    {
      target: '[data-tour="sync-source"]',
      title: 'Clockify sync vs. the built-in timer',
      body: 'This badge says where your hours come from. Green "Clockify Synced" means Clockify sessions are pulled in automatically and combined with what you log here. Orange "Internal Timer" means only this timer and your manual entries count. Tap it to switch the integration on or off.',
    },
    {
      target: '[data-tour="nav-tracker"]',
      title: 'Time Tracker',
      body: "Log or edit sessions by hand for days you forgot to clock in — attach a screenshot as proof so your coordinator can approve it.",
    },
        {
      target: '[data-tour="nav-dtr"]',
      title: 'DTR Sheet',
      body: 'Your Daily Time Record builds itself from tracked hours. Edit any cell like a spreadsheet, then print it or export it as a school-ready PDF form.',
    },
    {
      target: '[data-tour="nav-attendance"]',
      title: 'Attendance Chart',
      body: 'Mark each day Present, WFH, Absent, Sick or Vacation. Days you mark as worked but never logged get flagged on your DTR.',
    },
    {
      target: '[data-tour="nav-settings"]',
      title: 'Settings',
      body: 'Target hours, start date, company and supervisor details, pay rate, your coordinator link, and the Clockify integration all live here.',
    },
    {
      target: '[data-tour="tour-button"]',
      title: 'Replay this tour any time',
      body: 'Lost later on? This button reopens the walkthrough from wherever you are. That is the whole app — go clock in.',
    },
  ];

  window.InternFlowTour?.register('dashboard', dashboardTourSteps);

  // The header's timer and sync badge fill themselves in from an async request; give them a beat
  // so the walkthrough doesn't drop the steps that point at them.
  function startTour(force) {
    // The setup wizard has to be finished first — the dashboard behind it is still empty.
    if (document.getElementById('setup-wizard-overlay')) return;
    setTimeout(() => {
      if (force) window.InternFlowTour?.start();
      else window.InternFlowTour?.startIfNew();
    }, 700);
  }

  // Bind close buttons to dismiss and mark as seen
  const closeBtn = worksModal?.querySelector('.btn-onboarding');
  closeBtn?.addEventListener('click', () => {
    localStorage.setItem('has_seen_onboarding_student', 'true');
    worksModal.style.display = 'none';
    startTour(false);
  });

  // A brand-new account (straight out of the setup wizard) enters onboarding mode, which is what
  // makes every other page introduce itself on first visit too. Existing users are never
  // interrupted — they replay any page's walkthrough from the header's tour button.
  if (isFirstLogin) window.InternFlowTour?.beginOnboarding();

  if (params.get('tour') === '1') {
    startTour(true);
  } else if (!showedIntroModal && window.InternFlowTour?.isOnboarding()) {
    startTour(false);
  }

  // Clear query parameters
  if (isFirstLogin || params.get('tour')) {
    const newUrl = window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }

  const successVal = params.get('success');
  if (successVal) {
    const msg = successVal === 'true' ? 'Dashboard updated' : successVal;
    window.showToast(msg, 'success');
    const newUrl = window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }
  if (params.get('error')) {
    window.showToast(decodeURIComponent(params.get('error')), 'error');
    const newUrl = window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }

  // Period breakdown modal. Saving a payout shifts the carry-over into every later period, so the
  // rows are re-fetched from the server rather than patched here — the money math stays in one place.
  (() => {
    const modal = document.getElementById('breakdown-modal');
    const list = document.getElementById('breakdown-list');
    if (!modal || !list) return;

    const peso = (n) => `₱ ${Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const formatHours = (h) => {
      const total = Math.round(h * 3600);
      return `${String(Math.floor(total / 3600)).padStart(2, '0')}:${String(Math.floor((total % 3600) / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
    };

    const open = () => { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; };
    const close = () => { modal.style.display = 'none'; document.body.style.overflow = ''; };

    document.querySelectorAll('.open-breakdown').forEach(btn => btn.addEventListener('click', open));
    document.getElementById('breakdown-close')?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display === 'flex') close();
    });

    async function refresh() {
      const res = await fetch('/api/payouts');
      if (!res.ok) return;
      const data = await res.json();

      const rows = data.rows.slice().reverse();
      list.replaceChildren();

      rows.forEach(row => {
        const el = document.createElement('div');
        el.className = 'bd-row';
        el.dataset.label = row.label;

        const amount = row.isAdjusted ? row.actualReceived : row.totalExpected;
        const meta = !data.isEmployee && data.payType === 'daily' && data.isEarningsMode
          ? `${row.daysWorked} ${row.daysWorked === 1 ? 'day' : 'days'} worked · ${formatHours(row.rendered)}`
          : `${formatHours(row.rendered)} tracked`;

        const main = document.createElement('div');
        main.className = 'bd-main';
        const label = document.createElement('span');
        label.className = 'bd-label';
        label.textContent = row.label;
        const metaEl = document.createElement('span');
        metaEl.className = 'bd-meta';
        metaEl.textContent = meta;
        if (row.carryOverIn !== 0 && data.isEarningsMode) {
          const carry = document.createElement('span');
          carry.className = `bd-carry ${row.carryOverIn > 0 ? 'plus' : 'minus'}`;
          carry.textContent = `${row.carryOverIn > 0 ? '+' : ''}₱${Number(row.carryOverIn).toLocaleString('en-US', { maximumFractionDigits: 2 })} carry-over`;
          metaEl.appendChild(carry);
        }
        main.append(label, metaEl);

        const values = document.createElement('div');
        values.className = 'bd-values';
        values.innerHTML = data.isEarningsMode
          ? `<div class="bd-amount-group">
               <span class="bd-amount-label"></span>
               <span class="bd-amount"></span>
             </div>
             <div class="bd-actions"></div>
             <div class="bd-edit" style="display: none;">
               <span class="bd-currency">₱</span>
               <input type="number" step="0.01" class="bd-edit-input" />
               <button type="button" class="bd-btn-save">Save</button>
               <button type="button" class="bd-btn-cancel">Cancel</button>
             </div>`
          : `<div class="bd-amount-group">
               <span class="bd-amount-label">Rendered</span>
               <span class="bd-amount"></span>
             </div>`;

        if (data.isEarningsMode) {
          values.querySelector('.bd-amount-label').textContent = row.isAdjusted ? 'Received' : 'Expected';
          const amountEl = values.querySelector('.bd-amount');
          amountEl.textContent = peso(amount);
          amountEl.classList.toggle('received', row.isAdjusted);
          values.querySelector('.bd-edit-input').value = Number(amount).toFixed(2);

          const actions = values.querySelector('.bd-actions');
          if (!row.isAdjusted) {
            const received = document.createElement('button');
            received.type = 'button';
            received.className = 'bd-btn-received';
            received.dataset.amount = Number(row.totalExpected).toFixed(2);
            received.textContent = 'Received';
            actions.appendChild(received);
          }
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'bd-btn-edit';
          edit.dataset.amount = Number(amount).toFixed(2);
          edit.textContent = 'Edit';
          actions.appendChild(edit);
        } else {
          values.querySelector('.bd-amount').textContent = formatHours(row.rendered);
        }

        el.append(main, values);
        list.appendChild(el);
      });

      const total = data.rows.reduce((sum, r) => sum + r.calculated, 0);
      const totalEl = document.getElementById('breakdown-total-value');
      if (totalEl) totalEl.textContent = peso(total);
    }

    async function save(label, amount) {
      const res = await fetch('/api/payouts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ periodLabel: label, amountReceived: amount }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        window.showToast(data.error || 'Could not save that payout', 'error');
        return;
      }
      await refresh();
      window.showToast('Payout updated', 'success');
    }

    list.addEventListener('click', (e) => {
      const row = e.target.closest('.bd-row');
      if (!row) return;
      const label = row.dataset.label;

      if (e.target.closest('.bd-btn-received')) {
        save(label, parseFloat(e.target.closest('.bd-btn-received').dataset.amount));
      } else if (e.target.closest('.bd-btn-edit')) {
        row.querySelector('.bd-amount-group').style.display = 'none';
        row.querySelector('.bd-actions').style.display = 'none';
        row.querySelector('.bd-edit').style.display = 'flex';
        row.querySelector('.bd-edit-input').focus();
      } else if (e.target.closest('.bd-btn-cancel')) {
        row.querySelector('.bd-amount-group').style.display = '';
        row.querySelector('.bd-actions').style.display = '';
        row.querySelector('.bd-edit').style.display = 'none';
      } else if (e.target.closest('.bd-btn-save')) {
        const value = parseFloat(row.querySelector('.bd-edit-input').value);
        if (Number.isFinite(value)) save(label, value);
      }
    });
  })();

  // Handle visual loading state on form submissions
  document.addEventListener('submit', (e) => {
    const form = e.target;
    if (form.dataset.submitting === 'true') return;

    const btn = e.submitter || form.querySelector('button[type="submit"]');
    if (!btn) return;

    btn.disabled = true;
    btn.style.opacity = '0.7';

    let loadingText = 'Loading...';
    if (btn.classList.contains('btn-received')) {
      loadingText = 'UPDATING...';
    } else if (btn.classList.contains('btn-save-inline')) {
      loadingText = 'SAVING...';
    } else if (form.classList.contains('setup-form')) {
      loadingText = 'SETTING UP...';
    } else {
      const text = btn.innerText.trim().toUpperCase();
      if (text) {
        loadingText = text + '...';
      }
    }
    
    btn.innerHTML = `
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" style="display:inline-block; vertical-align:middle; width:16px; height:16px; animation: spin 1s linear infinite; margin-right: 8px;">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" style="opacity: 0.25;"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" style="opacity: 0.75;"></path>
      </svg>
      ${loadingText}
    `;
    
    if (window.showLoadingSpinner) {
      window.showLoadingSpinner(loadingText);
    }
    
    form.dataset.submitting = 'true';
  });

  // Time Masking Logic
  document.addEventListener('input', (e) => {
    if (e.target.classList.contains('time-mask')) {
      let val = e.target.value.replace(/\D/g, '');
      if (val.length > 4) val = val.slice(0, 4);

      // Auto-colon only for 4 digits as you type
      if (val.length === 4) {
        e.target.value = val.slice(0, 2) + ':' + val.slice(2);
      } else {
        e.target.value = val;
      }
    }
  });

  // Progress Trend chart: crosshair + tooltip on hover/touch
  (() => {
    const svg = document.getElementById('progress-chart-svg');
    const dataEl = document.getElementById('progress-chart-data');
    if (!svg || !dataEl) return;

    const points = JSON.parse(dataEl.textContent);
    if (!points.length) return;

    const crosshair = document.getElementById('progress-chart-crosshair');
    const dot = document.getElementById('progress-chart-hover-dot');
    const tooltip = document.getElementById('progress-chart-tooltip');
    const padLeft = parseFloat(svg.dataset.padLeft);
    const plotW = parseFloat(svg.dataset.plotW);

    function nearestPoint(evt) {
      const pt = svg.createSVGPoint();
      pt.x = evt.clientX;
      pt.y = evt.clientY;
      const ctm = svg.getScreenCTM();
      if (!ctm) return null;
      const svgPoint = pt.matrixTransform(ctm.inverse());
      const ratio = Math.min(1, Math.max(0, (svgPoint.x - padLeft) / plotW));
      const idx = Math.round(ratio * (points.length - 1));
      return points[idx];
    }

    function showAt(p) {
      crosshair.setAttribute('x1', p.x);
      crosshair.setAttribute('x2', p.x);
      crosshair.style.opacity = '1';
      dot.setAttribute('cx', p.x);
      dot.setAttribute('cy', p.y);
      dot.style.opacity = '1';

      tooltip.querySelector('.tt-value').textContent = `${p.hours}h`;
      tooltip.querySelector('.tt-date').textContent = p.date;
      tooltip.style.opacity = '1';

      const rect = svg.getBoundingClientRect();
      const scale = rect.width / svg.viewBox.baseVal.width;
      const left = Math.min(rect.width - 100, Math.max(0, p.x * scale - 50));
      tooltip.style.left = left + 'px';
      tooltip.style.top = Math.max(0, p.y * scale - 46) + 'px';
    }

    function hide() {
      crosshair.style.opacity = '0';
      dot.style.opacity = '0';
      tooltip.style.opacity = '0';
    }

    svg.addEventListener('pointermove', (e) => {
      const p = nearestPoint(e);
      if (p) showAt(p);
    });
    svg.addEventListener('pointerleave', hide);
  })();

  function formatTimeInput(target) {
    let val = target.value.replace(/\D/g, '');
    if (!val) return;
    
    const is24hr = !target.closest('.time-12hr-wrapper');
    
    if (val.length === 1) {
      const num = parseInt(val, 10);
      if (num >= 1 && num <= 9) {
        target.value = '0' + val + ':00';
      } else if (num === 0) {
        target.value = is24hr ? '00:00' : '12:00';
      }
    } else if (val.length === 2) {
      const num = parseInt(val, 10);
      const maxHour = is24hr ? 23 : 12;
      if (num >= 1 && num <= maxHour) {
        target.value = val + ':00';
      } else if (num === 0) {
        target.value = is24hr ? '00:00' : '12:00';
      } else {
        const h = parseInt(val[0], 10);
        let m = parseInt(val[1], 10);
        if (m > 5) m = 5;
        target.value = '0' + h + ':' + m + '0';
      }
    } else if (val.length === 3) {
      target.value = '0' + val[0] + ':' + val.slice(1);
    } else if (val.length === 4) {
      target.value = val.slice(0, 2) + ':' + val.slice(2);
    }
  }

  document.addEventListener('change', (e) => {
    if (e.target.classList.contains('time-mask')) {
      formatTimeInput(e.target);
    }
  }, true);

  document.addEventListener('blur', (e) => {
    if (e.target.classList.contains('time-mask')) {
      formatTimeInput(e.target);
    }
  }, true);

  // Handle backspace
  document.addEventListener('keydown', (e) => {
    if (e.target.classList.contains('time-mask') && e.key === 'Backspace') {
      if (e.target.value.includes(':') && e.target.value.length === 5) {
         // Let normal backspace work
      }
    }
  });
</script>

