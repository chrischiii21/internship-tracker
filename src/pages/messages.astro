---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { getSession, isAdmin, ADMIN_EMAIL } from '../lib/auth';
import { parse } from 'cookie';
import { getAppSettings } from '../lib/settings';
import { supabase } from '../lib/supabase';
import { sendMail } from '../lib/mail';

const cookies = parse(Astro.request.headers.get('cookie') || '');
const user = cookies.session ? await getSession(cookies.session) : null;
if (!user) return Astro.redirect('/');

const settings = await getAppSettings(user.id);
const admin = isAdmin(user);
// A user only ever sees their own conversation; the admin picks one from the inbox with ?u=.
const threadId = admin ? Astro.url.searchParams.get('u') : user.id;
const back = (error = '') => {
  const q = new URLSearchParams();
  if (admin && threadId) q.set('u', threadId);
  if (error) q.set('error', error);
  return Astro.redirect(`/messages${q.size ? `?${q}` : ''}`);
};

if (Astro.request.method === 'POST') {
  const body = String((await Astro.request.formData()).get('body') || '').trim();
  if (!threadId) return back('Pick a conversation first');
  if (!body || body.length > 2000) return back('Message must be 1–2000 characters');

  // Rate limit, counted from the table itself so it holds across serverless instances. The admin
  // is exempt. A user's only write path is their own thread, so thread_user_id is the sender.
  // ponytail: two parallel sends can both pass the check; move to a DB trigger if that's ever abused.
  if (!admin) {
    const sentSince = async (ms: number) => (await supabase.from('messages').select('id', { count: 'exact', head: true })
      .eq('thread_user_id', user.id).eq('from_admin', false)
      .gte('created_at', new Date(Date.now() - ms).toISOString())).count || 0;
    const [lastMinute, lastDay] = await Promise.all([sentSince(60_000), sentSince(86_400_000)]);
    if (lastMinute >= 5) return back('You’re sending messages too fast — wait a minute and try again');
    if (lastDay >= 30) return back('Daily message limit reached (30) — try again tomorrow');
  }

  // Email the other side only when this starts a fresh batch of unread messages, so a burst of
  // messages sends one email, not one each. Checked before the insert so it doesn't count itself.
  const { count: alreadyUnread } = await supabase.from('messages').select('id', { count: 'exact', head: true })
    .eq('thread_user_id', threadId).eq('from_admin', admin).is('read_at', null);

  const { error } = await supabase.from('messages').insert({
    thread_user_id: threadId,
    from_admin: admin,
    body,
    ...(admin ? {} : { user_name: user.name, user_email: user.email, user_picture: user.picture }),
  });
  if (error) {
    console.error('Message send error:', error);
    return back(error.message);
  }

  if (!alreadyUnread) {
    const link = new URL(admin ? '/messages' : `/messages?u=${encodeURIComponent(threadId)}`, Astro.url.origin).toString();
    if (admin) {
      const { data: owner } = await supabase.from('messages').select('user_email')
        .eq('thread_user_id', threadId).eq('from_admin', false).not('user_email', 'is', null).limit(1).maybeSingle();
      await sendMail(owner?.user_email, 'New reply from InternFlow', `${body}\n\nReply here: ${link}`);
    } else {
      await sendMail(ADMIN_EMAIL, `New feedback from ${user.name || user.email}`, `${body}\n\nFrom: ${user.email}\nOpen: ${link}`);
    }
  }
  return back();
}

let loadError = '';

// Admin inbox: one row per user, newest conversation first.
// ponytail: reads every message to build the list; page it or add a threads view past ~10k messages.
type Thread = { id: string; name: string; email: string; picture: string; last: string; at: string; unread: number };
const threads: Thread[] = [];
if (admin) {
  const { data, error } = await supabase.from('messages').select('*').order('created_at', { ascending: false });
  if (error) loadError = error.message;
  const byId = new Map<string, Thread>();
  for (const m of data || []) {
    let t = byId.get(m.thread_user_id);
    if (!t) {
      t = { id: m.thread_user_id, name: '', email: '', picture: '', last: m.body, at: m.created_at, unread: 0 };
      byId.set(t.id, t);
      threads.push(t);
    }
    if (!m.from_admin) {
      t.name ||= m.user_name || '';
      t.email ||= m.user_email || '';
      t.picture ||= m.user_picture || '';
      if (!m.read_at) t.unread++;
    }
  }
}

let messages: any[] = [];
if (threadId) {
  const { data, error } = await supabase
    .from('messages').select('*').eq('thread_user_id', threadId).order('created_at', { ascending: true });
  if (error) loadError = error.message;
  messages = data || [];
  // Opening the conversation marks the other side's messages as read.
  if (messages.some((m) => m.from_admin !== admin && !m.read_at)) {
    await supabase.from('messages').update({ read_at: new Date().toISOString() })
      .eq('thread_user_id', threadId).eq('from_admin', !admin).is('read_at', null);
  }
}
const current = threads.find((t) => t.id === threadId);

const fmt = (iso: string) => new Date(iso).toLocaleString('en-US', {
  month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila',
});
---

<Layout title={admin ? 'Inbox' : 'Feedback'}>
  <Header user={user} />
  <div id="portal-body">
    <Sidebar user={user} activeTab="messages" role={settings.role} />
    <main id="portal-main">
      <div class="bg-grid" aria-hidden="true"></div>
      <div class="msg-content">
        <div class="page-header">
          <h1>{admin ? <>User <span class="accent">Inbox</span></> : <>Send <span class="accent">Feedback</span></>}</h1>
          <p>{admin
            ? 'Suggestions and questions from people using InternFlow.'
            : 'Tell us what you need, what’s broken, or what would make InternFlow better. We read every message.'}</p>
        </div>

        {loadError && <div class="load-error">Couldn’t load messages: {loadError}</div>}

        <div class:list={['msg-layout', { 'is-admin': admin, 'has-thread': !!threadId }]}>
          {admin && (
            <aside class="thread-list">
              {threads.length === 0 && <div class="empty">No messages yet.</div>}
              {threads.map((t) => (
                <a href={`/messages?u=${encodeURIComponent(t.id)}`} class:list={['thread', { active: t.id === threadId }]}>
                  {t.picture ? <img src={t.picture} alt="" width="32" height="32" /> : <span class="avatar-ph">{(t.name || '?')[0]}</span>}
                  <div class="thread-text">
                    <div class="thread-top"><strong>{t.name || t.email || 'Unknown user'}</strong><time>{fmt(t.at)}</time></div>
                    <div class="thread-last">{t.last}</div>
                  </div>
                  {t.unread > 0 && <span class="badge" aria-label={`${t.unread} unread`}>{t.unread}</span>}
                </a>
              ))}
            </aside>
          )}

          {threadId ? (
            <section class="conversation">
              {admin && (
                <div class="conv-head">
                  <a href="/messages" class="back-link" aria-label="Back to inbox">←</a>
                  <div><strong>{current?.name || 'Unknown user'}</strong><span>{current?.email}</span></div>
                </div>
              )}
              <div class="bubbles" id="bubbles">
                {messages.length === 0 && <div class="empty">No messages yet. Say hi 👋</div>}
                {messages.map((m) => (
                  <div class:list={['bubble', m.from_admin === admin ? 'mine' : 'theirs']}>
                    <p>{m.body}</p>
                    <time>{fmt(m.created_at)}{m.from_admin === admin && m.read_at ? ' · Seen' : ''}</time>
                  </div>
                ))}
              </div>
              <form method="POST" class="composer">
                <label for="msg-body" class="sr-only">Message</label>
                <textarea id="msg-body" name="body" rows="2" maxlength="2000" required
                  placeholder={admin ? 'Write a reply…' : 'Write your suggestion…'}></textarea>
                <button type="submit" class="send-btn">Send</button>
              </form>
            </section>
          ) : (
            <section class="conversation placeholder"><div class="empty">Select a conversation.</div></section>
          )}
        </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const params = new URLSearchParams(location.search);
  if (params.get('error')) {
    window.showToast?.(params.get('error'), 'error');
    params.delete('error');
    history.replaceState({}, '', location.pathname + (params.size ? `?${params}` : ''));
  }
  const bubbles = document.getElementById('bubbles');
  if (bubbles) bubbles.scrollTop = bubbles.scrollHeight;

  // Live updates: re-fetch this page while it's visible and swap in the conversation and inbox
  // list, leaving the composer (and anything half-typed) alone.
  // ponytail: polls the full page every 8s; move to Supabase Realtime if many people sit on it.
  const swap = (doc, sel) => {
    const now = document.querySelector(sel), next = doc.querySelector(sel);
    if (!now || !next || now.innerHTML === next.innerHTML) return;
    const atBottom = now.scrollHeight - now.scrollTop - now.clientHeight < 40;
    const top = now.scrollTop;
    now.innerHTML = next.innerHTML;
    now.scrollTop = sel === '#bubbles' && atBottom ? now.scrollHeight : top;
  };
  setInterval(async () => {
    if (document.hidden) return;
    try {
      const res = await fetch(location.href, { headers: { Accept: 'text/html' } });
      if (!res.ok) return;
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      swap(doc, '#bubbles');
      swap(doc, '.thread-list');
    } catch {}
  }, 8000);
  // Enter sends, Shift+Enter adds a new line.
  document.getElementById('msg-body')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      e.target.form.requestSubmit();
    }
  });
</script>

<style>
  #portal-body { display: flex; min-height: 100vh; padding-top: 56px; }
  #portal-main { margin-left: 220px; flex: 1; padding: 40px; position: relative; min-width: 0; }
  .bg-grid { position: fixed; inset: 0; background-image: linear-gradient(rgba(237, 102, 33, .04) 1px, transparent 1px), linear-gradient(90deg, rgba(237, 102, 33, .04) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
  .msg-content { position: relative; z-index: 1; max-width: 1100px; }

  .page-header { margin-bottom: 24px; }
  .page-header h1 { font-size: 28px; font-weight: 700; color: #fff; letter-spacing: -0.02em; }
  .page-header p { color: var(--text-secondary); font-size: 14px; margin-top: 4px; }
  .accent { background: var(--ntv-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .load-error { background: rgba(239, 68, 68, .1); border: 1px solid rgba(239, 68, 68, .3); color: #fca5a5; padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; }

  .msg-layout { display: grid; grid-template-columns: 1fr; gap: 16px; height: calc(100vh - 56px - 80px - 90px); min-height: 420px; }
  .msg-layout.is-admin { grid-template-columns: 300px 1fr; }

  .thread-list, .conversation {
    background: rgba(5, 11, 22, 0.6); border: 1px solid rgba(237, 102, 33, 0.14);
    border-radius: 12px; overflow: hidden; min-height: 0;
  }
  .thread-list { overflow-y: auto; }
  .thread { display: flex; align-items: center; gap: 10px; padding: 12px 14px; text-decoration: none; color: inherit; border-bottom: 1px solid rgba(255,255,255,.05); }
  .thread:hover { background: rgba(237, 102, 33, 0.06); }
  .thread.active { background: rgba(237, 102, 33, 0.14); }
  .thread img, .avatar-ph { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; }
  .avatar-ph { display: grid; place-items: center; background: rgba(237,102,33,.2); color: var(--ntv-orange); font-weight: 700; text-transform: uppercase; }
  .thread-text { flex: 1; min-width: 0; }
  .thread-top { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; color: var(--text-primary); }
  .thread-top strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .thread-top time { font-size: 10px; color: var(--text-secondary); white-space: nowrap; }
  .thread-last { font-size: 12px; color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 2px; }
  .badge { background: var(--ntv-orange); color: #fff; font-size: 11px; font-weight: 700; border-radius: 999px; padding: 2px 7px; }

  .conversation { display: flex; flex-direction: column; }
  .conv-head { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,.06); }
  .conv-head div { display: flex; flex-direction: column; font-size: 13px; color: var(--text-primary); }
  .conv-head span { font-size: 11px; color: var(--text-secondary); }
  .back-link { display: none; color: var(--ntv-orange); text-decoration: none; font-size: 20px; }

  .bubbles { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .bubble { max-width: min(75%, 560px); padding: 10px 14px; border-radius: 14px; font-size: 14px; line-height: 1.45; }
  .bubble p { white-space: pre-wrap; overflow-wrap: anywhere; color: var(--text-primary); }
  .bubble time { display: block; font-size: 10px; margin-top: 4px; color: var(--text-secondary); }
  .bubble.mine { align-self: flex-end; background: rgba(237, 102, 33, 0.18); border: 1px solid rgba(237, 102, 33, 0.3); border-bottom-right-radius: 4px; }
  .bubble.mine time { text-align: right; }
  .bubble.theirs { align-self: flex-start; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); border-bottom-left-radius: 4px; }

  .composer { display: flex; gap: 10px; padding: 12px; border-top: 1px solid rgba(255,255,255,.06); }
  .composer textarea {
    flex: 1; resize: none; background: rgba(0,0,0,.25); border: 1px solid rgba(237, 102, 33, 0.2);
    border-radius: 10px; padding: 10px 12px; color: var(--text-primary); font: inherit; font-size: 14px;
  }
  .composer textarea:focus { outline: none; border-color: var(--ntv-orange); }
  .send-btn { background: var(--ntv-gradient); color: #fff; border: none; border-radius: 10px; padding: 0 20px; font-size: 13px; font-weight: 600; cursor: pointer; }
  .send-btn:hover { filter: brightness(1.15); }

  .empty { color: var(--text-secondary); font-size: 13px; text-align: center; padding: 32px 16px; margin: auto; }
  .placeholder { justify-content: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-width: 900px) {
    #portal-main { margin-left: 0; padding: 20px 16px; width: 100%; }
    .msg-layout { height: calc(100dvh - 56px - 40px - 110px); }
    .msg-layout.is-admin { grid-template-columns: 1fr; }
    /* On phones the admin sees the list or one conversation, not both. */
    .msg-layout.is-admin.has-thread .thread-list,
    .msg-layout.is-admin:not(.has-thread) .conversation { display: none; }
    .back-link { display: block; }
    .bubble { max-width: 85%; }
  }
</style>
