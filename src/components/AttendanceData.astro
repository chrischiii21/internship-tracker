---
// Server island for the attendance calendar (server:defer in pages/attendance.astro): the page
// shell paints right away and each day's status — which needs the month's logged hours from
// entries and Clockify — arrives in this request. The page has already worked out whose calendar
// it is (a coordinator can open a student's) and passes those ids as encrypted props; the session
// must still belong to the viewer they were issued for.
import { getSession } from '../lib/auth';
import { parse } from 'cookie';
import { getAppSettings } from '../lib/settings';
import { getClockifyUser, getDailyDTR } from '../lib/clockify';
import { getManualEntries, getActiveTimer } from '../lib/entries';
import { getMonthlyAttendance } from '../lib/attendance';
import AttendanceCalendar from './AttendanceCalendar.astro';

interface Props {
  viewerId: string;
  viewUserId: string;
  viewIsEmployee: boolean;
  month: number;
  year: number;
  isEditable: boolean;
}

const { viewerId, viewUserId, viewIsEmployee, isEditable } = Astro.props;

// Per-user data: never let a shared cache hold on to it.
Astro.response.headers.set('Cache-Control', 'private, no-store');

// Switching month in place re-requests this island with ?month=&year= added to its URL.
const query = Astro.url.searchParams;
const queryMonth = Number(query.get('month'));
const queryYear = Number(query.get('year'));
const month = Number.isInteger(queryMonth) && queryMonth >= 1 && queryMonth <= 12 ? queryMonth : Astro.props.month;
const year = Number.isInteger(queryYear) && queryYear >= 2000 && queryYear <= 2100 ? queryYear : Astro.props.year;

const cookies = parse(Astro.request.headers.get('cookie') || '');
const user = cookies.session ? await getSession(cookies.session) : null;
const settings = user && user.id === viewerId ? await getAppSettings(viewUserId) : null;

let days = null;
if (settings) {
  const isClockifySet = !!(import.meta.env.CLOCKIFY_API_KEY && import.meta.env.CLOCKIFY_WORKSPACE_ID);

  const [manual, clockifyUser] = await Promise.all([
    getManualEntries(viewUserId, viewIsEmployee),
    isClockifySet && settings.clockifyEnabled !== false ? getClockifyUser(settings.userEmail || "").catch(() => null) : null,
  ]);
  const manualFiltered = manual.filter((e) => {
    const d = new Date(e.startFull || `${e.date}T${e.startTime}+08:00`);
    return d.getMonth() + 1 === month && d.getFullYear() === year;
  });

  const dtrResult = await getDailyDTR(clockifyUser?.id || "", month, year, manualFiltered);
  const dailyTotals: Record<number, number> = {};
  for (const d of dtrResult.days) dailyTotals[parseInt(d.day)] = d.totalSeconds;

  // A running (not yet clocked out) timer has no `end`, so getDailyDTR never counts it into
  // dailyTotals — without this, today's cell sits blank while the intern is actively clocked in.
  const activeTimer = await getActiveTimer(viewUserId, viewIsEmployee);
  const ongoingDate = activeTimer
    ? new Date(activeTimer.startTime).toLocaleDateString("en-CA", { timeZone: "Asia/Manila" })
    : null;

  ({ days } = await getMonthlyAttendance(viewUserId, viewIsEmployee, month, year, dailyTotals, ongoingDate));
}
---

{days
  ? <AttendanceCalendar month={month} year={year} isEditable={isEditable} days={days} />
  : <p class="session-ended">Your session has ended. <a href="/">Sign in again</a> to see this calendar.</p>}

<style>
  .session-ended { color: var(--text-secondary); font-size: 14px; text-align: center; }
  .session-ended a { color: var(--ntv-orange); font-weight: 700; }
</style>
