---
// Server island (server:defer in Sidebar.astro): the admin's newest active announcement
// (pages/announcements.astro), shown as a popup up to max_views app opens per device. Deferred so
// the lookup never delays a page. View counts live in localStorage keyed by announcement id, so
// each new announcement starts fresh even for people who closed the last one.
import { getSession, isAdmin } from '../lib/auth';
import { parse } from 'cookie';
import { supabase } from '../lib/supabase';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const cookies = parse(Astro.request.headers.get('cookie') || '');
const user = cookies.session ? await getSession(cookies.session) : null;

let ann: { id: string; title: string; body: string; max_views: number } | null = null;
if (user && !isAdmin(user)) {
  const { data } = await supabase.from('announcements').select('id, title, body, max_views')
    .eq('active', true).order('created_at', { ascending: false }).limit(1).maybeSingle();
  ann = data;
}
---

{ann && (
  <dialog id="broadcast-popup" class="bc" aria-labelledby="bc-title" data-id={ann.id} data-max={ann.max_views ?? 1}>
    <form method="dialog">
      <button class="bc-close" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </form>
    <div class="bc-icon" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
    </div>
    <span class="bc-pill">Announcement</span>
    <h2 id="bc-title">{ann.title}</h2>
    <p class="bc-body">{ann.body}</p>
    <form method="dialog"><button class="bc-ok">Got it</button></form>
  </dialog>
)}

{ann && (
  <script is:inline>
    (() => {
      const dlg = document.getElementById('broadcast-popup');
      if (!dlg || typeof dlg.showModal !== 'function') return;
      // Shown at most once per app open (sessionStorage lasts until the tab/app is closed), and
      // for max app opens in total per device (localStorage count). max 0 = every open.
      const key = 'internflow-broadcast-' + dlg.dataset.id;
      const max = Number(dlg.dataset.max) || 0;
      let shown;
      try {
        if (sessionStorage.getItem(key)) return;
        shown = Number(localStorage.getItem(key)) || 0;
      } catch { return; }
      if (max > 0 && shown >= max) return;
      const countIt = () => {
        try { sessionStorage.setItem(key, '1'); localStorage.setItem(key, String(shown + 1)); } catch {}
      };

      // Wait out the onboarding tour and any other open dialog (feature announcement,
      // confirm box) so popups never stack; show this one as soon as the screen is clear.
      const busy = () => {
        const tour = document.getElementById('tour-root');
        return (tour && !tour.hidden) || document.querySelector('dialog[open]');
      };
      const tryShow = () => {
        if (dlg.open) return;
        if (busy()) return setTimeout(tryShow, 1500);
        countIt();
        dlg.showModal();
      };
      setTimeout(tryShow, 1500);
    })();
  </script>
)}

<style>
  .bc {
    width: 420px; max-width: calc(100% - 32px); max-height: calc(100% - 32px); overflow-y: auto;
    margin: auto; padding: 24px; border-radius: 18px;
    background: var(--modal-bg); color: var(--text-primary);
    border: 1px solid rgba(237, 102, 33, 0.3); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .bc[open] { animation: bc-pop .4s cubic-bezier(.16,1,.3,1) both; }
  .bc::backdrop { background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(3px); }
  @keyframes bc-pop { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }

  .bc-close {
    position: absolute; top: 14px; right: 14px; background: none; border: none; padding: 6px;
    color: var(--text-secondary); cursor: pointer; border-radius: 8px;
  }
  .bc-close:hover { background: rgba(127, 127, 127, 0.12); color: var(--text-primary); }
  .bc-icon {
    width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center;
    background: rgba(237, 102, 33, 0.12); color: var(--ntv-orange); margin-bottom: 14px;
  }
  .bc-pill {
    display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ntv-orange); background: rgba(237, 102, 33, 0.12); border: 1px solid rgba(237, 102, 33, 0.3);
    border-radius: 999px; padding: 3px 9px; margin-bottom: 8px;
  }
  .bc h2 { font-size: 20px; font-weight: 700; line-height: 1.25; margin-bottom: 10px; padding-right: 24px; overflow-wrap: anywhere; }
  .bc-body { font-size: 14px; line-height: 1.6; color: var(--text-secondary); white-space: pre-wrap; overflow-wrap: anywhere; margin-bottom: 20px; }
  .bc-ok {
    display: block; width: 100%; font: inherit; font-size: 14px; font-weight: 600; color: #fff;
    background: var(--ntv-gradient); border: none; border-radius: 10px; padding: 12px 16px; cursor: pointer;
  }
  .bc-ok:hover { filter: brightness(1.15); }

  /* Phones: bottom sheet, clear of the iPhone home bar. */
  @media (max-width: 600px) {
    .bc {
      width: 100%; max-width: 100%; max-height: 88dvh; margin: auto 0 0;
      border-radius: 20px 20px 0 0; border-bottom: none;
      padding: 22px 18px calc(18px + env(safe-area-inset-bottom));
    }
    .bc[open] { animation-name: bc-sheet; }
    @keyframes bc-sheet { from { transform: translateY(100%); } to { transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) { .bc[open] { animation: none; } }
</style>
