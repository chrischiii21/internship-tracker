---
const { user } = Astro.props;
---

<header id="sys-header">
  <div class="header-left">
    <button id="mobile-menu-toggle" class="menu-toggle" aria-label="Toggle Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="logo-mark">
      <img src="/logo-64.png" alt="Logo" width="32" height="32" />
    </div>
    <div class="logo-text">
      <span class="logo-primary">InternFlow</span>
      <span class="logo-sep">/</span>
      <span class="logo-secondary">Progress Tracker</span>
    </div>
  </div>
  <div class="header-center">
    <div class="clock-wrapper">
      <span class="pulse-dot green"></span>
      <span id="live-clock" class="live-clock">--:--:-- --</span>
      <span class="clock-tz">PHT</span>
    </div>
  </div>
  <div class="header-right">
    <a id="sync-source-badge" class="sync-badge" href="/settings" data-tour="sync-source" style="display: none;">
      <svg class="sync-icon icon-cloud" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97A6 6 0 0 0 6.2 9.2 4.4 4.4 0 0 0 7 18h1"/><path d="M12 12v9"/><path d="m9 18 3 3 3-3"/></svg>
      <svg class="sync-icon icon-timer" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/></svg>
      <span id="sync-badge-label" class="sync-badge-label">Internal Timer</span>
    </a>
    <div id="clock-toggle-wrap" class="clock-toggle-wrap" style="display: none;">
      <button type="button" id="clock-toggle-btn" class="clock-toggle-btn">
        <span class="clock-toggle-dot"></span>
        <span id="clock-toggle-label">Time In</span>
        <span id="clock-toggle-elapsed" class="clock-toggle-elapsed" style="display: none;"></span>
      </button>
      <button type="button" id="clock-adjust-btn" class="clock-adjust-btn" style="display: none;" title="Adjust start time">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4L18.5 2.5z"></path></svg>
      </button>
      <div id="clock-adjust-popover" class="clock-adjust-popover" style="display: none;">
        <span class="clock-adjust-label">Started at</span>
        <input type="time" id="clock-adjust-input" class="clock-adjust-input" />
        <button type="button" id="clock-adjust-save" class="clock-adjust-save" title="Save">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
    </div>
    <div class="user-info">
      <button type="button" id="tour-trigger" class="theme-toggle-btn" title="Take a tour of this app" aria-label="Take a tour of this app" data-tour="tour-button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </button>
      <button type="button" id="theme-toggle" class="theme-toggle-btn" title="Toggle Theme" style="outline: none;">
        <!-- Sun icon (shown in light mode) -->
        <svg id="theme-sun-icon" class="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <!-- Moon icon (shown in dark mode) -->
        <svg id="theme-moon-icon" class="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      {user?.picture && <img class="avatar" src={user.picture} alt={user.name} width="28" height="28" />}
      <span class="user-name">{user?.name?.split(' ')[0]}</span>
      <button type="button" id="logout-trigger" class="logout-btn" title="Sign out">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><polyline points="16,17 21,12 16,7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><line x1="21" y1="12" x2="9" y2="12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- LOGOUT MODAL -->
<div id="logout-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <div class="logout-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </div>
      <h2>Sign out?</h2>
    </div>
    <p class="modal-desc">Are you sure you want to end your current session? You'll need to log in again to access your dashboard.</p>
    <div class="modal-actions">
      <button type="button" id="close-logout-modal" class="btn-cancel">Stay Logged In</button>
      <a href="/api/auth/logout" class="btn-confirm-logout">Yes, Sign Out</a>
    </div>
  </div>
</div>

<!-- PUNCH MODAL -->
<!-- Stands between the Time In/Out button and the timer. Two jobs: remind the user to tap their
     company's RFID reader (this tracker can't punch them in or out over there), and capture the
     time they actually tapped, so the entry matches that record instead of whenever they got
     around to opening this app. -->
<div id="punch-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <div class="punch-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M7 15h4"/><circle cx="16" cy="12" r="2.5"/></svg>
      </div>
      <h2 id="punch-title">Tap in first</h2>
    </div>
    <p class="modal-desc" id="punch-desc"></p>

    <div class="punch-field">
      <label for="punch-time-input" id="punch-time-label">Time you tapped in</label>
      <input type="time" id="punch-time-input" class="punch-time-input" />
    </div>
    <p class="punch-summary" id="punch-summary"></p>
    <p class="punch-error" id="punch-error" style="display: none;"></p>

    <div class="modal-actions">
      <button type="button" id="punch-cancel" class="btn-cancel">Cancel</button>
      <button type="button" id="punch-confirm" class="btn-confirm-punch">Start Timer</button>
    </div>
  </div>
</div>

<style>
  #sys-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; height: 56px;
    background: rgba(5, 11, 22, 0.88); backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .header-left { display: flex; align-items: center; gap: 10px; }
  .logo-mark { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; overflow: hidden; }
  .logo-mark img { width: 100%; height: 100%; object-fit: contain; }
  .logo-text { display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; }
  .logo-primary { color: var(--ntv-orange); font-weight: 800; letter-spacing: .08em; }
  .logo-sep { color: rgba(255,255,255,.22); font-weight: 300; }
  .logo-secondary { color: var(--text-secondary); font-weight: 400; }
  .clock-wrapper { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,.04); border: 1px solid var(--border-subtle); border-radius: 20px; padding: 5px 14px; }
  .live-clock { font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 500; color: var(--text-primary); letter-spacing: .06em; }
  .clock-tz { font-size: 10px; font-weight: 600; color: var(--ntv-orange); letter-spacing: .1em; background: rgba(237, 102, 33, 0.15); padding: 2px 6px; border-radius: 4px; }
  .pulse-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; animation: pdot 2s ease-in-out infinite; }
  .green { background: #34d399; box-shadow: 0 0 7px #34d399; }
  @keyframes pdot { 0%,100%{opacity:1} 50%{opacity:.35} }

  .header-right { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }

  /* Tells the user at a glance where their hours are coming from, so the DTR total is never a mystery. */
  .sync-badge {
    display: flex; align-items: center; gap: 6px; flex-shrink: 0;
    padding: 5px 10px; border-radius: 20px; text-decoration: none;
    font-size: 11px; font-weight: 700; letter-spacing: .02em;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-subtle);
    color: var(--text-secondary); transition: all .2s;
  }
  .sync-badge:hover { filter: brightness(1.15); }
  .sync-badge .sync-icon { flex-shrink: 0; }
  .sync-badge .icon-cloud { display: none; }
  .sync-badge.synced { background: rgba(52, 211, 153, 0.12); border-color: rgba(52, 211, 153, 0.32); color: #34d399; }
  .sync-badge.synced .icon-cloud { display: block; }
  .sync-badge.synced .icon-timer { display: none; }
  .sync-badge.internal { background: rgba(237, 102, 33, 0.1); border-color: rgba(237, 102, 33, 0.3); color: var(--ntv-orange); }

  .clock-toggle-wrap { position: relative; display: flex; align-items: center; gap: 6px; }
  .clock-toggle-btn {
    display: flex; align-items: center; gap: 8px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-subtle);
    color: var(--text-primary); padding: 7px 14px; border-radius: 20px;
    font-size: 12px; font-weight: 700; cursor: pointer; transition: all .2s;
  }
  .clock-toggle-btn:hover { background: rgba(255, 255, 255, 0.09); }
  .clock-toggle-btn:disabled { opacity: 0.6; cursor: wait; }
  .clock-toggle-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.35); flex-shrink: 0; }
  .clock-toggle-btn.on { background: rgba(34, 197, 94, 0.12); border-color: rgba(34, 197, 94, 0.35); color: #4ade80; }
  .clock-toggle-btn.on .clock-toggle-dot { background: #4ade80; box-shadow: 0 0 6px #4ade80; animation: pdot 2s ease-in-out infinite; }
  .clock-toggle-elapsed { font-family: 'JetBrains Mono', monospace; font-weight: 500; opacity: 0.85; }

  .clock-adjust-btn {
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 8px; flex-shrink: 0;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-subtle);
    color: var(--text-secondary); cursor: pointer; transition: all .2s;
  }
  .clock-adjust-btn:hover { background: rgba(255, 255, 255, 0.09); color: var(--text-primary); }
  .clock-adjust-popover {
    position: absolute; top: calc(100% + 8px); right: 0; z-index: 200;
    display: flex; align-items: center; gap: 8px;
    background: var(--modal-bg); border: 1px solid var(--border-subtle);
    border-radius: 12px; padding: 8px 10px; box-shadow: 0 12px 30px rgba(0,0,0,0.3);
  }
  .clock-adjust-label { font-size: 11px; font-weight: 600; color: var(--text-secondary); white-space: nowrap; }
  .clock-adjust-input {
    background: rgba(255,255,255,0.05); border: 1px solid var(--border-subtle); border-radius: 8px;
    color: var(--text-primary); font-family: 'JetBrains Mono', monospace; font-size: 12px;
    padding: 4px 6px; outline: none; color-scheme: dark;
  }
  :global(.light-mode) .clock-adjust-input { color-scheme: light; }
  .clock-adjust-save {
    display: flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 6px; flex-shrink: 0;
    background: var(--ntv-gradient); border: none; color: #fff; cursor: pointer; transition: 0.2s;
  }
  .clock-adjust-save:hover { filter: brightness(1.1); transform: scale(1.05); }
  .clock-adjust-save:disabled { opacity: 0.6; cursor: wait; }

  @media (max-width: 900px) {
    #clock-toggle-elapsed { display: none !important; }
    .clock-toggle-btn { padding: 7px 10px; }
    .sync-badge-label { display: none; }
    .sync-badge { padding: 6px; }
  }

  .user-info { display: flex; align-items: center; gap: 10px; }
  .avatar { border-radius: 50%; border: 2px solid var(--ntv-orange); }
  .user-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
  .logout-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px;
    background: rgba(230, 30, 42, 0.1); border: 1px solid rgba(230, 30, 42, 0.2);
    color: #f87171; text-decoration: none; transition: all .2s;
  }
  .logout-btn:hover { background: var(--ntv-red); color: white; transform: scale(1.05); }

  @media print {
    #sys-header { display: none !important; }
  }

  .menu-toggle { display: none; background: none; border: none; color: var(--text-primary); cursor: pointer; padding: 4px; border-radius: 6px; }
  .menu-toggle:hover { background: rgba(255,255,255,0.05); }

  @media (max-width: 900px) {
    .menu-toggle { display: block; margin-right: 8px; }
    .logo-secondary, .logo-sep, .user-name { display: none; }
    #sys-header { padding: 0 16px; }
    .header-center { display: none; }
    .header-right { gap: 8px; }
  }

  @media (max-width: 420px) {
    #clock-toggle-label { display: none; }
    .clock-toggle-btn { padding: 7px 9px; }
    .header-right { gap: 6px; }
    .user-info { gap: 6px; }
    .theme-toggle-btn, .logout-btn { width: 28px; height: 28px; margin-right: 0; }
  }

  /* LOGOUT MODAL STYLES */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(5, 11, 22, 0.85);
    backdrop-filter: blur(8px); z-index: 2000; display: flex;
    align-items: center; justify-content: center; padding: 20px;
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .modal-overlay.active { opacity: 1; pointer-events: auto; }
  
  .modal-content {
    background: #0d1421; border: 1px solid var(--border-subtle);
    border-radius: 20px; width: 100%; max-width: 400px; padding: 32px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.6);
    transform: scale(0.95) translateY(10px); transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .modal-overlay.active .modal-content { transform: scale(1) translateY(0); }
  
  .modal-header { text-align: center; margin-bottom: 20px; }
  .logout-icon { 
    display: inline-flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; background: rgba(237, 102, 33, 0.1);
    color: var(--ntv-orange); border-radius: 50%; margin-bottom: 16px;
    border: 1px solid rgba(237, 102, 33, 0.2);
  }
  .modal-header h2 { font-size: 22px; font-weight: 700; color: #fff; }
  .modal-desc { font-size: 14px; color: var(--text-secondary); text-align: center; line-height: 1.6; margin-bottom: 32px; }
  
  .modal-actions { display: flex; flex-direction: column; gap: 12px; }
  .btn-confirm-logout {
    display: block; text-align: center; text-decoration: none;
    width: 100%; padding: 14px; background: var(--ntv-gradient); color: #fff;
    border: none; border-radius: 12px; font-size: 14px; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-confirm-logout:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 4px 15px rgba(237, 102, 33, 0.3); }

  .punch-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; background: rgba(237, 102, 33, 0.1);
    color: var(--ntv-orange); border-radius: 50%; margin-bottom: 16px;
    border: 1px solid rgba(237, 102, 33, 0.2);
  }
  .punch-field {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin: 18px 0 10px; padding: 12px 14px;
    background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-subtle); border-radius: 12px;
  }
  .punch-field label { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
  .punch-time-input {
    background: rgba(0, 0, 0, 0.25); border: 1px solid var(--border-subtle); border-radius: 8px;
    color: var(--text-primary); font-family: 'JetBrains Mono', monospace; font-size: 15px;
    font-weight: 600; padding: 8px 10px; min-width: 120px;
  }
  .punch-time-input:focus { outline: none; border-color: var(--ntv-orange); }
  .punch-summary {
    font-size: 12.5px; color: var(--text-secondary); text-align: center;
    margin: 0 0 4px; min-height: 18px;
  }
  .punch-error {
    font-size: 12.5px; color: #ff6b6b; text-align: center; margin: 4px 0 0;
  }
  .btn-confirm-punch {
    display: block; text-align: center; width: 100%; padding: 14px;
    background: var(--ntv-gradient); color: #fff; border: none; border-radius: 12px;
    font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s;
  }
  .btn-confirm-punch:hover:not(:disabled) { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 4px 15px rgba(237, 102, 33, 0.3); }
  .btn-confirm-punch:disabled { opacity: 0.6; cursor: not-allowed; }

  @media (max-width: 520px) {
    .punch-field { flex-direction: column; align-items: stretch; }
    .punch-time-input { width: 100%; }
  }
  
  .btn-cancel {
    width: 100%; padding: 14px; background: rgba(255, 255, 255, 0.05); color: var(--text-primary);
    border: 1px solid var(--border-subtle); border-radius: 12px; font-size: 14px; font-weight: 600;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-cancel:hover { background: rgba(255, 255, 255, 0.08); }

  .theme-toggle-btn {
    display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 8px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-subtle);
    color: var(--text-primary); cursor: pointer; transition: all 0.2s;
    margin-right: 4px;
  }
  .theme-toggle-btn:hover { background: rgba(255, 255, 255, 0.08); transform: scale(1.05); }
</style>

<script>
  // Theme Toggle Logic
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  function updateThemeIcons() {
    const isLight = document.documentElement.classList.contains('light-mode');
    if (isLight) {
      if (sunIcon) sunIcon.style.display = 'block';
      if (moonIcon) moonIcon.style.display = 'none';
    } else {
      if (sunIcon) sunIcon.style.display = 'none';
      if (moonIcon) moonIcon.style.display = 'block';
    }
  }

  // Initial set
  updateThemeIcons();

  themeToggle?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light-mode');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    updateThemeIcons();
  });

  // Mobile Menu Logic
  document.getElementById('mobile-menu-toggle')?.addEventListener('click', () => {
    document.body.classList.toggle('sidebar-open');
  });

  // "Take a tour" — replays the walkthrough registered by the current page. Pages without their
  // own tour hand the user to the Dashboard one, which covers the app as a whole.
  document.getElementById('tour-trigger')?.addEventListener('click', () => {
    const tour = window.InternFlowTour;
    if (tour && tour.hasTour()) {
      tour.start();
    } else {
      window.location.href = '/dashboard?tour=1';
    }
  });

  // Logout Modal Logic
  const logoutModal = document.getElementById('logout-modal');
  const logoutTrigger = document.getElementById('logout-trigger');
  const closeLogoutBtn = document.getElementById('close-logout-modal');

  logoutTrigger?.addEventListener('click', (e) => {
    e.preventDefault();
    logoutModal?.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  const closeLogoutModal = () => {
    logoutModal?.classList.remove('active');
    document.body.style.overflow = '';
  };

  closeLogoutBtn?.addEventListener('click', closeLogoutModal);
  logoutModal?.addEventListener('click', (e) => {
    if (e.target === logoutModal) closeLogoutModal();
  });

  function tick() {
    const pht = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' }));
    const h = String(pht.getHours()).padStart(2,'0'), m = String(pht.getMinutes()).padStart(2,'0'), s = String(pht.getSeconds()).padStart(2,'0');
    const el = document.getElementById('live-clock');
    if (el) el.textContent = `${h}:${m}:${s}`;
  }
  tick(); setInterval(tick, 1000);

  // Global Time In / Time Out widget. Self-contained: fetches its own state so it works on any
  // page that includes the Header, without every page having to thread timer state through as a prop.
  (function () {
    const wrap = document.getElementById('clock-toggle-wrap');
    const btn = document.getElementById('clock-toggle-btn');
    const labelEl = document.getElementById('clock-toggle-label');
    const elapsedEl = document.getElementById('clock-toggle-elapsed');
    const adjustBtn = document.getElementById('clock-adjust-btn');
    const adjustPopover = document.getElementById('clock-adjust-popover');
    const adjustInput = document.getElementById('clock-adjust-input');
    const adjustSaveBtn = document.getElementById('clock-adjust-save');
    if (!wrap || !btn || !labelEl || !elapsedEl) return;

    let elapsedInterval = null;
    let startTimeMs = null;
    const originalTitle = document.title;

    function formatElapsed(ms) {
      const totalSec = Math.max(0, Math.floor(ms / 1000));
      const h = String(Math.floor(totalSec / 3600)).padStart(2, '0');
      const m = String(Math.floor((totalSec % 3600) / 60)).padStart(2, '0');
      const s = String(totalSec % 60).padStart(2, '0');
      return `${h}:${m}:${s}`;
    }

    function stopElapsedTicker() {
      if (elapsedInterval) {
        clearInterval(elapsedInterval);
        elapsedInterval = null;
      }
      document.title = originalTitle;
    }

    function startElapsedTicker() {
      stopElapsedTicker();
      elapsedInterval = setInterval(() => {
        if (startTimeMs == null) return;
        const formatted = formatElapsed(Date.now() - startTimeMs);
        elapsedEl.textContent = formatted;
        document.title = `${formatted} · ${originalTitle}`;
      }, 1000);
    }

    function render(active, startTime) {
      wrap.style.display = 'flex';
      btn.classList.toggle('on', active);
      if (adjustBtn) adjustBtn.style.display = active ? 'flex' : 'none';
      if (active) {
        labelEl.textContent = 'Time Out';
        startTimeMs = startTime ? new Date(startTime).getTime() : Date.now();
        elapsedEl.style.display = 'inline';
        elapsedEl.textContent = formatElapsed(Date.now() - startTimeMs);
        startElapsedTicker();
      } else {
        labelEl.textContent = 'Time In';
        elapsedEl.style.display = 'none';
        stopElapsedTicker();
        startTimeMs = null;
        if (adjustPopover) adjustPopover.style.display = 'none';
      }
    }

    // Adjust-start-time popover: lets the user correct the clock-in time without stopping the
    // timer, so the elapsed counter recalculates from the corrected start instead of restarting.
    adjustBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (startTimeMs == null || !adjustPopover || !adjustInput) return;
      const manila = new Date(new Date(startTimeMs).toLocaleString('en-US', { timeZone: 'Asia/Manila' }));
      adjustInput.value = `${String(manila.getHours()).padStart(2, '0')}:${String(manila.getMinutes()).padStart(2, '0')}`;
      adjustPopover.style.display = adjustPopover.style.display === 'flex' ? 'none' : 'flex';
    });

    adjustSaveBtn?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const val = adjustInput?.value;
      if (!val) return;
      adjustSaveBtn.disabled = true;
      try {
        const res = await fetch('/api/timer/status', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ startTime: val }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to adjust start time');
        startTimeMs = new Date(data.startTime).getTime();
        elapsedEl.textContent = formatElapsed(Date.now() - startTimeMs);
        adjustPopover.style.display = 'none';
        window.showToast?.('Start time updated', 'success');
      } catch (err) {
        window.showToast?.(err.message || 'Error updating start time', 'error');
      } finally {
        adjustSaveBtn.disabled = false;
      }
    });

    document.addEventListener('click', (e) => {
      if (adjustPopover && adjustPopover.style.display === 'flex' &&
          !adjustPopover.contains(e.target) && e.target !== adjustBtn) {
        adjustPopover.style.display = 'none';
      }
    });

    // Which source feeds the hours totals and the DTR: Clockify sessions synced in, or only the
    // built-in timer plus manual entries. Ambiguity here is what makes DTR totals confusing.
    function renderSyncSource(data) {
      const badge = document.getElementById('sync-source-badge');
      const label = document.getElementById('sync-badge-label');
      if (!badge || !label) return;

      const synced = data.source === 'clockify';
      badge.style.display = 'flex';
      badge.classList.toggle('synced', synced);
      badge.classList.toggle('internal', !synced);
      label.textContent = synced ? 'Clockify Synced' : 'Internal Timer';
      badge.title = synced
        ? 'Clockify sync is ON — sessions tracked in Clockify flow into your hours and DTR automatically. Time In/Out here uses the built-in timer, and both sources are combined.'
        : data.clockifyEnabled
          ? 'Your email is not linked to a Clockify account — hours come from the built-in Time In/Out timer and manual entries only. Tap to manage the integration.'
          : 'Clockify sync is OFF — hours come from the built-in Time In/Out timer and manual entries only. Tap to turn sync back on.';
    }

    async function loadStatus() {
      try {
        const res = await fetch('/api/timer/status');
        if (!res.ok) return;
        const data = await res.json();
        if (!data.applicable) {
          btn.style.display = 'none';
          return;
        }
        renderSyncSource(data);
        render(data.active, data.startTime);
      } catch (e) {}
    }

    // ---- Punch modal -------------------------------------------------------------------
    // The Time In/Out button no longer punches directly. It opens a confirmation that reminds
    // the user to tap their company's attendance reader and asks what time they tapped, so this
    // tracker's entry lines up with that record rather than with their reaction time.
    const punchModal = document.getElementById('punch-modal');
    const punchTitle = document.getElementById('punch-title');
    const punchDesc = document.getElementById('punch-desc');
    const punchTimeLabel = document.getElementById('punch-time-label');
    const punchInput = document.getElementById('punch-time-input');
    const punchSummary = document.getElementById('punch-summary');
    const punchError = document.getElementById('punch-error');
    const punchConfirm = document.getElementById('punch-confirm');
    const punchCancel = document.getElementById('punch-cancel');

    let punchMode = 'in';

    function manilaNowHHMM() {
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Manila', hour: '2-digit', minute: '2-digit', hour12: false,
      }).formatToParts(new Date());
      const h = parts.find((p) => p.type === 'hour')?.value ?? '00';
      const m = parts.find((p) => p.type === 'minute')?.value ?? '00';
      return `${h === '24' ? '00' : h}:${m}`;
    }

    function fmtClock(ms) {
      return new Date(ms).toLocaleTimeString('en-US', {
        timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit', hour12: true,
      });
    }

    // Mirrors the server's punch resolution so the preview can't disagree with what gets saved:
    // a punch-in later than now belongs to yesterday, a punch-out before the start to tomorrow.
    function resolvePunchInMs(timeStr) {
      const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Manila' });
      const ms = new Date(`${today}T${timeStr}:00+08:00`).getTime();
      return ms > Date.now() + 60000 ? ms - 86400000 : ms;
    }

    function resolvePunchOutMs(timeStr, startMs) {
      const startDay = new Date(startMs).toLocaleDateString('en-CA', { timeZone: 'Asia/Manila' });
      const ms = new Date(`${startDay}T${timeStr}:00+08:00`).getTime();
      return ms < startMs ? ms + 86400000 : ms;
    }

    function updatePunchSummary() {
      if (!punchInput || !punchSummary) return;
      const value = punchInput.value;
      if (!/^\d{2}:\d{2}$/.test(value)) {
        punchSummary.textContent = '';
        if (punchConfirm) punchConfirm.disabled = true;
        return;
      }
      if (punchConfirm) punchConfirm.disabled = false;

      if (punchMode === 'in') {
        const ms = resolvePunchInMs(value);
        const agoMin = Math.round((Date.now() - ms) / 60000);
        punchSummary.textContent = agoMin > 1
          ? `Timer starts at ${fmtClock(ms)} — ${agoMin} min ago`
          : `Timer starts at ${fmtClock(ms)}`;
      } else if (startTimeMs != null) {
        const endMs = resolvePunchOutMs(value, startTimeMs);
        const future = endMs > Date.now() + 60000;
        punchSummary.textContent = future
          ? 'That time is in the future — check the reader.'
          : `${fmtClock(startTimeMs)} → ${fmtClock(endMs)} · ${formatElapsed(endMs - startTimeMs)}`;
        if (punchConfirm) punchConfirm.disabled = future;
      }
    }

    function openPunchModal(isActive) {
      punchMode = isActive ? 'out' : 'in';
      if (punchError) { punchError.style.display = 'none'; punchError.textContent = ''; }

      if (punchTitle) punchTitle.textContent = punchMode === 'in' ? 'Tap in first' : 'Tap out first';
      if (punchDesc) {
        punchDesc.textContent = punchMode === 'in'
          ? "If your company records attendance on its own system — an RFID reader, a portal — tap in there before starting this timer. This tracker can't punch you in over there."
          : "Tap out on your company's reader before stopping this timer. Its record is the one that counts, and a missed tap leaves that day open.";
      }
      if (punchTimeLabel) punchTimeLabel.textContent = punchMode === 'in' ? 'Time you tapped in' : 'Time you tapped out';
      if (punchConfirm) punchConfirm.textContent = punchMode === 'in' ? 'Start Timer' : 'Stop Timer';
      if (punchInput) punchInput.value = manilaNowHHMM();

      updatePunchSummary();
      punchModal?.classList.add('active');
      // Focusing the input would pop the mobile keyboard over the reminder text, which is the
      // part that needs reading — "now" is already filled in for the common case.
      punchConfirm?.focus();
    }

    function closePunchModal() {
      punchModal?.classList.remove('active');
      btn.disabled = false;
    }

    async function submitPunch() {
      const time = punchInput?.value;
      if (!/^\d{2}:\d{2}$/.test(time || '')) return;

      punchModal?.classList.remove('active');
      btn.disabled = true;
      // The request is followed by a full page reload, so cover both with the global overlay —
      // otherwise the punch looks like it did nothing until the page happens to come back.
      window.showLoadingSpinner?.(punchMode === 'out' ? 'TIMING OUT...' : 'TIMING IN...');
      try {
        const res = await fetch('/api/timer/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ time }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to toggle timer');
        render(data.active, data.startTime);

        // Pages that render timer-dependent server data (e.g. the Dashboard's task timer card)
        // need a fresh render to stay in sync with this client-only toggle.
        if (data.capped) {
          // A forgotten timer was trimmed to one shift — hold the reload back so the explanation
          // is actually readable before the page repaints.
          window.hideLoadingSpinner?.();
          window.showToast?.(data.message, 'error');
          setTimeout(() => window.location.reload(), 6000);
        } else {
          window.showToast?.(data.active ? 'Timed in' : 'Timed out', 'success');
          window.location.reload();
        }
      } catch (err) {
        // Server-side rejections (future punch-out, punch-in older than a day) are about the
        // time that was typed, so reopen the modal with the message instead of dropping the
        // user back to a button that looks like it did nothing.
        window.hideLoadingSpinner?.();
        if (punchError) {
          punchError.textContent = err.message || 'Error toggling timer';
          punchError.style.display = 'block';
        }
        punchModal?.classList.add('active');
        btn.disabled = false;
      }
    }

    btn.addEventListener('click', () => {
      btn.disabled = true;
      openPunchModal(btn.classList.contains('on'));
    });

    punchInput?.addEventListener('input', updatePunchSummary);
    punchConfirm?.addEventListener('click', submitPunch);
    punchCancel?.addEventListener('click', closePunchModal);
    punchModal?.addEventListener('click', (e) => {
      if (e.target === punchModal) closePunchModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && punchModal?.classList.contains('active')) closePunchModal();
    });

    loadStatus();
  })();
</script>
