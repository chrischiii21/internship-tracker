---
// Server island for the Time Tracker's activity log (server:defer in pages/tracker.astro): the
// page shell — filters, total box, Manual Adjustment form — paints right away, and the entries
// (this system's plus Clockify's) arrive in this request. It checks the session itself, and the
// session must belong to the viewer the page issued it for.
import { getSession } from '../lib/auth';
import { parse } from 'cookie';
import { getAppSettings } from '../lib/settings';
import TrackerLog from './TrackerLog.astro';

interface Props {
  viewerId: string;
  startDate?: string;
  endDate?: string;
  source?: string;
  page?: string;
}

const { viewerId, startDate, endDate, source, page } = Astro.props;

// Per-user data: never let a shared cache hold on to it.
Astro.response.headers.set('Cache-Control', 'private, no-store');

const cookies = parse(Astro.request.headers.get('cookie') || '');
const user = cookies.session ? await getSession(cookies.session) : null;
const settings = user && user.id === viewerId ? await getAppSettings(user.id) : null;
---

{user && settings && settings.role !== 'coordinator'
  ? <TrackerLog user={user} settings={settings} startDate={startDate} endDate={endDate} source={source} page={page} />
  : <p class="session-ended">Your session has ended. <a href="/">Sign in again</a> to see your logs.</p>}

<style>
  .session-ended { color: var(--text-secondary); font-size: 14px; }
  .session-ended a { color: var(--ntv-orange); font-weight: 700; }
</style>
