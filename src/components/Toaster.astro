<div id="toast-container"></div>

<dialog id="confirm-dialog">
  <form method="dialog">
    <p id="confirm-message"></p>
    <div class="confirm-actions">
      <button value="cancel" class="confirm-cancel">Cancel</button>
      <button value="ok" class="confirm-ok">Confirm</button>
    </div>
  </form>
</dialog>

<script is:inline>
  // In-app replacement for window.confirm(). Resolves true only on the confirm button; Esc, Cancel
  // and a backdrop click resolve false.
  window.showConfirm = function(message, okLabel = 'Confirm') {
    const dlg = document.getElementById('confirm-dialog');
    dlg.querySelector('#confirm-message').textContent = message;
    dlg.querySelector('.confirm-ok').textContent = okLabel;
    dlg.returnValue = '';
    dlg.showModal();
    return new Promise(resolve => dlg.addEventListener('close', () => resolve(dlg.returnValue === 'ok'), { once: true }));
  };
  document.getElementById('confirm-dialog').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) e.currentTarget.close();
  });

  window.showToast = function(message, type = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    
    const icon = type === 'success' 
      ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>'
      : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';

    toast.innerHTML = `
      <div class="toast-icon">${icon}</div>
      <div class="toast-message">${message}</div>
    `;

    container.appendChild(toast);

    // Auto remove after 4 seconds
    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => toast.remove(), 400);
    }, 4000);
  };
</script>

<style is:global>
  #toast-container {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 9999;
    display: flex;
    flex-direction: column-reverse;
    gap: 12px;
    pointer-events: none;
  }

  .toast {
    pointer-events: auto;
    min-width: 320px;
    max-width: 420px;
    padding: 14px 20px;
    background: rgba(13, 14, 26, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    gap: 14px;
    animation: toast-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toast.success {
    border-left: 4px solid #34d399;
  }
  .toast.success .toast-icon {
    color: #34d399;
  }

  .toast.error {
    border-left: 4px solid #f87171;
  }
  .toast.error .toast-icon {
    color: #f87171;
  }

  .toast-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .toast-message {
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .toast.fade-out {
    opacity: 0;
    transform: translateX(40px);
  }

  #confirm-dialog {
    margin: auto;
    width: min(400px, calc(100% - 32px));
    padding: 0;
    background: var(--modal-bg);
    color: var(--text-primary);
    border: 1px solid rgba(237, 102, 33, 0.3);
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    font-family: 'Outfit', sans-serif;
  }
  #confirm-dialog[open] { animation: toast-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) both; }
  #confirm-dialog::backdrop { background: rgba(5, 11, 22, 0.6); backdrop-filter: blur(4px); }
  #confirm-dialog form { padding: 24px; }
  #confirm-message { font-size: 15px; font-weight: 500; line-height: 1.5; margin-bottom: 20px; }
  .confirm-actions { display: flex; justify-content: flex-end; gap: 10px; }
  .confirm-actions button {
    padding: 10px 18px; border-radius: 10px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer;
  }
  .confirm-cancel { background: rgba(var(--fg-rgb), 0.05); border: 1px solid var(--border-subtle); color: var(--text-primary); }
  .confirm-cancel:hover { background: rgba(var(--fg-rgb), 0.09); }
  .confirm-ok { background: var(--ntv-gradient); border: none; color: #fff; }
  .confirm-ok:hover { filter: brightness(1.1); }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @media (max-width: 600px) {
    #toast-container {
      bottom: 16px;
      right: 16px;
      left: 16px;
      transform: none;
    }
    .toast {
      min-width: unset;
      width: 100%;
    }
    .toast.fade-out {
      transform: translateY(20px);
    }
  }
</style>
