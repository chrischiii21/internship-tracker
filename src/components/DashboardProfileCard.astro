---
// Settings-only summary card. It needs no hour data, so the dashboard shows it in the page shell
// right away and DashboardData renders the same card once the stats land.
import type { AppSettings } from '../lib/settings';

interface Props {
  settings: AppSettings;
}

const { settings } = Astro.props;
const activeStartDate = settings.isEmployee ? (settings.employeeStartDate || settings.startDate) : settings.startDate;
const activePaySchedule = settings.isEmployee ? (settings.employeePaySchedule || 'monthly') : settings.paySchedule;
const activeCompany = settings.isEmployee ? (settings.employerCompany || settings.hostCompany) : settings.hostCompany;
---

{settings.isEmployee ? (
  <div class="metric-card company-summary">
    <div class="company-header-mini">
      <div class="company-info-mini">
        <span class="metric-label">Employment Details</span>
        <div class="metric-value-mini text-truncate">{activeCompany || 'Not set'}</div>
      </div>
    </div>
    <div class="company-quick-details">
      <div class="quick-row">
        <span class="q-label">Employment Type:</span>
        <span class="q-value">Full-time / Personal Tracker</span>
      </div>
      <div class="quick-row">
        <span class="q-label">Monthly Rate:</span>
        <span class="q-value">₱{settings.monthlyRate?.toLocaleString()} / month</span>
      </div>
      <div class="quick-row">
        <span class="q-label">Pay Schedule:</span>
        <span class="q-value">{activePaySchedule === 'semi-monthly' ? 'Every 15 days (Semi-monthly)' : 'Monthly'}</span>
      </div>
      <div class="quick-row">
        <span class="q-label">Start Date:</span>
        <span class="q-value">{activeStartDate}</span>
      </div>
    </div>
  </div>
) : (
  <div class="metric-card company-summary">
    <div class="company-header-mini">
      <div class="company-info-mini">
        <span class="metric-label">Internship Configuration</span>
        <div class="metric-value-mini text-truncate">{settings.hostCompany || 'Not set'}</div>
      </div>
    </div>
    <div class="company-quick-details">
      <div class="quick-row">
        <span class="q-label">Program:</span>
        <span class="q-value">{settings.program || 'Not set'}</span>
      </div>
      <div class="quick-row">
        <span class="q-label">Allowance:</span>
        <span class="q-value">{settings.hasAllowance ? 'Enabled' : 'Disabled'}</span>
      </div>
      {settings.hasAllowance && (
        <>
          <div class="quick-row">
            <span class="q-label">Pay Model:</span>
            <span class="q-value">{settings.payType === 'hourly' ? 'Hourly' : 'Daily'}</span>
          </div>
          <div class="quick-row">
            <span class="q-label">Rate:</span>
            <span class="q-value">₱{settings.hourlyRate}/{settings.payType === 'hourly' ? 'hr' : 'day'}</span>
          </div>
          <div class="quick-row">
            <span class="q-label">Schedule:</span>
            <span class="q-value">{settings.paySchedule}</span>
          </div>
        </>
      )}
    </div>
  </div>
)}

<style>
  .metric-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .metric-card:hover { border-color: rgba(237, 102, 33, 0.3); transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.2); }
  .company-summary { gap: 14px !important; padding: 24px !important; border-color: rgba(237, 102, 33, 0.2); height: 100%; }
  .metric-label { font-size: 11px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }
  .company-header-mini { display: flex; align-items: center; gap: 14px; margin-bottom: 4px; }
  .company-info-mini { flex: 1; min-width: 0; }
  .metric-value-mini { font-size: 18px; font-weight: 800; color: var(--text-primary); line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .company-quick-details { display: flex; flex-direction: column; gap: 12px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.06); }
  .quick-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .q-label { font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; }
  .q-value { font-size: 12px; font-weight: 700; color: var(--text-primary); text-align: right; line-height: 1.4; }
</style>
