---
// The DTR sheet plus the "where these hours came from" banner. The DTR page renders it without
// `data` as an instant placeholder (the static parts filled in, the time grid shimmering), and
// DtrData renders it again with the month's hours once they load.
import type { AppSettings } from '../lib/settings';

interface DtrMonthData {
  dtrData: Record<string, any>;
  totalMonthSeconds: number;
  overridesByDay: Record<number, { status: string; isHalfDay: boolean; reason: string | null }>;
  shiftType: string;
  syncSource: 'clockify' | 'disabled' | 'unlinked';
}

interface Props {
  settings: AppSettings;
  viewUserId: string;
  month: number;
  year: number;
  isEditable: boolean;
  isCoordinator: boolean;
  data?: DtrMonthData;
}

const { settings, viewUserId, month, year, isEditable, isCoordinator, data } = Astro.props;

const formatDuration = (seconds: number) => {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
};

const monthName = new Date(year, month - 1)
  .toLocaleDateString("en-US", { month: "long", timeZone: "Asia/Manila" })
  .toUpperCase();

const isStandardDayShift = !data || data.shiftType === 'day';
const colGroup1Label = isStandardDayShift ? 'AM' : 'SHIFT';
const colGroup2Label = isStandardDayShift ? 'PM' : 'AFTER BREAK';

const statusLabels: Record<string, string> = { absent: 'ABSENT', wfh: 'WFH', sl: 'SL', vl: 'VL', present: 'PRESENT' };
const ACTIONABLE_STATUSES = new Set(['present', 'wfh']);

const daysInMonth = new Date(year, month, 0).getDate();
const syncSource = data?.syncSource;
---

<div
  id="dtr-data"
  data-filename={`DTR_${settings.userName?.replace(/\s+/g, "_") || (settings.isEmployee ? "Employee" : "Student")}_${monthName}_${year}.pdf`}
  data-official-filename={`Official_DTR_${(settings.userName || "Student").replace(/\s+/g, "_")}_${monthName}_${year}.pdf`}
  data-period={`${monthName} ${year}`}
>
  {syncSource ? (
    <div class={`no-print dtr-source-banner source-${syncSource}`} data-tour="dtr-source">
      <span class="source-dot"></span>
      <div class="source-text">
        {syncSource === "clockify" ? (
          <>
            <strong>Clockify Synced.</strong> This sheet combines your synced Clockify sessions with the built-in Time In/Out timer and any manual entries.
          </>
        ) : syncSource === "disabled" ? (
          <>
            <strong>Built-in timer only.</strong> Clockify sync is turned off, so these totals come from the Time In/Out timer and your manual entries.
          </>
        ) : (
          <>
            <strong>Built-in timer only.</strong> This email isn't linked to a Clockify account, so these totals come from the Time In/Out timer and your manual entries.
          </>
        )}
      </div>
      {syncSource !== "clockify" && !isCoordinator && (
        <a href="/settings" class="source-link">Manage sync</a>
      )}
    </div>
  ) : (
    <div class="no-print dtr-source-banner source-pending" data-tour="dtr-source">
      <span class="source-dot"></span>
      <div class="source-text">Loading this month's hours…</div>
    </div>
  )}

  <div class="dtr-scroll-wrapper content-center">
    <div
      class={`dtr-container ${data ? '' : 'is-loading'}`}
      id="dtr-sheet"
      data-user-id={viewUserId}
      data-year={year}
      data-month={month}
      aria-busy={data ? undefined : 'true'}
    >
      <header class="dtr-header">
        <div class="dtr-title">{settings.isEmployee ? "DAILY TIME RECORD" : "OJT DAILY TIME RECORD"}</div>

        <div class="dtr-info-grid">
          <div class="info-item">
            <span class="label">{settings.isEmployee ? "Employee Name:" : "OJT Student:"}</span>
            <span class="value underline">{settings.userName}</span>
          </div>
          {!settings.isEmployee && (
            <div class="info-item">
              <span class="label">Program:</span>
              <span class="value underline">{settings.program}</span>
            </div>
          )}
          <div class="info-item">
            <span class="label">{settings.isEmployee ? "Employer / Company:" : "Company:"}</span>
            <span class="value underline">{settings.hostCompany}</span>
          </div>
          <div class="info-item">
            <span class="label">Period:</span>
            <span class="value underline">{monthName} {year}</span>
          </div>
          {!settings.isEmployee && (
            <div class="info-item">
              <span class="label">Supervisor:</span>
              <span class="value underline">{settings.supervisor}</span>
            </div>
          )}
          <div class="info-item highlight">
            <span class="label">Total Hours:</span>
            <span class="value" id="total-monthly-hours-val">{data ? formatDuration(data.totalMonthSeconds) : <span class="sk-cell sk-total"></span>}</span>
          </div>
        </div>
      </header>

      <table class="dtr-table">
        <thead>
          <tr>
            <th rowspan="2">Date</th>
            <th colspan="2">{colGroup1Label}</th>
            <th colspan="2">{colGroup2Label}</th>
            <th rowspan="2">Total Hrs</th>
          </tr>
          <tr>
            <th>In</th>
            <th>Out</th>
            <th>In</th>
            <th>Out</th>
          </tr>
        </thead>
        <tbody>
          {data
            ? Object.entries(data.dtrData).map(([day, dayData]: [string, any]) => {
                const override = data.overridesByDay[parseInt(day, 10)];
                const hasOverride = dayData.totalSeconds === 0 && !!override;
                const needsInput = hasOverride && ACTIONABLE_STATUSES.has(override.status);
                const isInformational = hasOverride && !needsInput;
                const rowClass = needsInput
                  ? `needs-time-input status-${override.status}`
                  : isInformational
                  ? `attendance-note status-${override.status}`
                  : (dayData.totalSeconds === 0 ? "weekend-row" : "");
                return (
                <tr class={rowClass} data-day={day} data-override-status={override ? override.status : ""}>
                  <td class="date-col">
                    {day}
                    {hasOverride && (
                      <span class={`dtr-status-badge status-${override.status}`} title={override.reason ? `${statusLabels[override.status] || override.status}: ${override.reason}` : `Marked ${statusLabels[override.status] || override.status} in Attendance Chart`}>
                        {statusLabels[override.status] || override.status}
                      </span>
                    )}
                  </td>
                  {(['amIn', 'amOut', 'pmIn', 'pmOut'] as const).map((col) => (
                    <td class={isEditable ? "editable-cell" : ""}>
                      {isEditable ? (
                        <input
                          type="text"
                          class="dtr-grid-input"
                          value={dayData[col] || ""}
                          placeholder="--"
                          data-day={day}
                          data-col={col}
                        />
                      ) : (
                        dayData[col] || ""
                      )}
                    </td>
                  ))}
                  <td class="total-col row-total">
                    {dayData.totalSeconds > 0
                      ? formatDuration(dayData.totalSeconds)
                      : needsInput
                      ? <span class="no-log-hint">No log — input needed</span>
                      : isInformational
                      ? <span class="attendance-note-hint">{override?.reason || "No log expected"}</span>
                      : ""}
                  </td>
                </tr>
                );
              })
            : Array.from({ length: daysInMonth }, (_, i) => (
                <tr class="sk-row">
                  <td class="date-col">{i + 1}</td>
                  {/* Same cell contents as the real grid (disabled inputs) so columns don't jump when it lands. */}
                  {[0, 1, 2, 3].map(() => (
                    <td class={isEditable ? "editable-cell" : ""}>
                      {isEditable
                        ? <input type="text" class="dtr-grid-input" disabled tabindex="-1" aria-hidden="true" />
                        : <span class="sk-cell"></span>}
                    </td>
                  ))}
                  <td class="total-col"><span class="sk-cell"></span></td>
                </tr>
              ))}
        </tbody>
      </table>

      <footer class="dtr-footer">
        <div class="certification">
          {settings.isEmployee ? "Employee Certification:" : "Student Certification:"} I certify that I rendered the above
          service.
        </div>
        <div class="sig-lines">
          <div class="sig-group">
            <span class="sig-label">Signature:</span>
            <div class="sig-underline"></div>
          </div>
          <div class="sig-group">
            <span class="sig-label">Date:</span>
            <div class="sig-underline"></div>
          </div>
        </div>

        <div class="approval">VERIFIED & APPROVED:</div>
        <div class="sig-lines">
          <div class="sig-group {settings.isEmployee ? '' : 'full'}">
            <span class="sig-label">{settings.isEmployee ? "Supervisor / Manager Signature:" : "Supervisor Signature:"}</span>
            <div class="sig-underline"></div>
          </div>
          <div class="sig-group">
            <span class="sig-label">Date:</span>
            <div class="sig-underline"></div>
          </div>
          {!settings.isEmployee && (
            <div class="sig-group">
              <span class="sig-label">Position:</span>
              <span class="value">{settings.supervisorPosition}</span>
            </div>
          )}
        </div>
      </footer>
    </div>
  </div>
</div>

<style>
  /* Where this month's numbers came from */
  .dtr-source-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 1000px;
    margin: 0 auto 18px;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    background: rgba(237, 102, 33, 0.07);
    border: 1px solid rgba(237, 102, 33, 0.22);
  }
  .dtr-source-banner.source-clockify {
    background: rgba(52, 211, 153, 0.08);
    border-color: rgba(52, 211, 153, 0.25);
  }
  .dtr-source-banner strong { color: var(--text-primary); font-weight: 700; }
  .source-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--ntv-orange);
    box-shadow: 0 0 8px var(--ntv-orange);
  }
  .source-clockify .source-dot { background: #34d399; box-shadow: 0 0 8px #34d399; }
  .source-text { flex: 1; }
  .source-link {
    flex-shrink: 0;
    color: var(--ntv-orange);
    font-weight: 700;
    font-size: 12px;
    text-decoration: none;
    white-space: nowrap;
  }
  .source-link:hover { text-decoration: underline; }
  /* Placeholder banner while the month loads. */
  .dtr-source-banner.source-pending { background: rgba(127, 127, 127, 0.06); border-color: var(--border-subtle); }
  .source-pending .source-dot { background: var(--text-secondary); box-shadow: none; animation: sk-pulse 1.2s ease-in-out infinite; }

  .dtr-scroll-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 40px 20px;
    background: rgba(var(--fg-rgb), 0.04);
    display: flex;
    justify-content: flex-start;
  }
  @media (min-width: 860px) {
    .dtr-scroll-wrapper {
      justify-content: center;
    }
  }

  .dtr-container {
    background: white;
    color: black;
    padding: 0.1in 0.4in;
    width: 8.5in;
    height: 11in;
    margin: 0 auto;
    font-family: Arial, sans-serif;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
  }

  .dtr-title {
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    background: #d1d5db;
    padding: 8px;
    border: 3px solid #9ca3af;
    border-bottom: none;
  }
  .dtr-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 3px solid #9ca3af;
    border-top: none;
    background: #f3f4f6;
  }
  .info-item {
    padding: 6px 12px;
    border-right: 1px solid #9ca3af;
    border-bottom: 2px solid #9ca3af;
    font-size: 12px;
    display: flex;
    gap: 6px;
  }
  .info-item:nth-child(even) {
    border-right: none;
  }
  .info-item.highlight {
    background: #e5e7eb;
    font-weight: 700;
  }
  .label {
    font-weight: 600;
    width: 100px;
  }
  .underline {
    text-decoration: underline;
  }

  .dtr-table {
    width: 100%;
    border-collapse: collapse;
    border: 3px solid #9ca3af;
    margin-top: -3px;
    flex-grow: 1;
  }
  .dtr-table th {
    background: #d1d5db;
    border: 2px solid #9ca3af;
    padding: 6px;
    font-size: 11px;
    font-weight: 700;
    text-align: center;
  }
  .dtr-table td {
    border: 1px solid #9ca3af;
    padding: 2px 8px;
    font-size: 11px;
    height: 24px;
    text-align: center;
  }
  .dtr-table td.editable-cell {
    padding: 0;
  }
  .dtr-grid-input {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    text-align: center;
    font-family: inherit;
    font-size: 11px;
    color: inherit;
    padding: 2px 8px;
    box-sizing: border-box;
    cursor: cell;
    transition: all 0.15s ease;
  }
  .dtr-grid-input::placeholder {
    color: #cbd5e1;
  }
  .dtr-grid-input:focus {
    outline: none;
    background: #f0fdf4;
    box-shadow: inset 0 0 0 2px #22c55e;
    color: #15803d;
    font-weight: 600;
  }
  .row-saving {
    background-color: rgba(251, 191, 36, 0.15) !important;
  }
  .date-col {
    font-weight: 700;
    background: #f9fafb;
    width: 50px;
  }
  .total-col {
    font-weight: 700;
    background: #f9fafb;
  }
  .weekend-row {
    background: #fef2f2;
  }

  /* Present/WFH marked in the Attendance Chart with no actual time logged — actionable, needs input */
  .needs-time-input {
    background: #fffbeb;
    box-shadow: inset 3px 0 0 #f59e0b;
  }
  .needs-time-input.status-wfh { box-shadow: inset 3px 0 0 #ca8a04; }
  .needs-time-input.status-present { box-shadow: inset 3px 0 0 #16a34a; }

  /* Absent/SL/VL marked in the Attendance Chart — informational only, no log expected */
  .attendance-note {
    background: #f8fafc;
  }
  .attendance-note.status-absent { box-shadow: inset 3px 0 0 #be123c; }
  .attendance-note.status-sl { box-shadow: inset 3px 0 0 #b45309; }
  .attendance-note.status-vl { box-shadow: inset 3px 0 0 #7c3aed; }

  .dtr-status-badge {
    display: block;
    margin-top: 2px;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .03em;
    padding: 1px 4px;
    border-radius: 4px;
    color: #fff;
  }
  .dtr-status-badge.status-absent { background: #be123c; }
  .dtr-status-badge.status-wfh { background: #ca8a04; }
  .dtr-status-badge.status-sl { background: #b45309; }
  .dtr-status-badge.status-vl { background: #7c3aed; }
  .dtr-status-badge.status-present { background: #16a34a; }
  .no-log-hint {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    font-style: italic;
    color: #b45309;
  }
  .attendance-note-hint {
    display: inline-block;
    font-size: 9px;
    font-weight: 600;
    font-style: italic;
    color: #64748b;
    opacity: 0.9;
  }

  .dtr-footer {
    margin-top: auto;
    padding-top: 15px;
    font-size: 11px;
  }
  .certification {
    font-weight: 700;
    margin-bottom: 10px;
    font-size: 12px;
  }
  .sig-lines {
    display: flex;
    gap: 30px;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .sig-group {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .sig-group.full {
    flex: 1;
  }
  .sig-underline {
    border-bottom: 2px solid black;
    min-width: 140px;
    height: 16px;
  }
  .sig-label {
    font-weight: 700;
    white-space: nowrap;
  }
  .approval {
    font-weight: 700;
    margin-top: 15px;
    margin-bottom: 10px;
    font-size: 12px;
  }

  /* Placeholder cells while the month loads: the sheet keeps its shape, the times shimmer. */
  .sk-cell {
    display: block; height: 8px; width: 70%; margin: 0 auto; border-radius: 4px;
    background: linear-gradient(90deg, #eee 25%, #ddd 50%, #eee 75%);
    background-size: 200% 100%; animation: sk-shimmer 1.4s ease-in-out infinite;
  }
  .sk-total { display: inline-block; width: 44px; height: 10px; vertical-align: middle; }
  .sk-row .dtr-grid-input { background: #f1f1f1; cursor: default; animation: sk-pulse 1.4s ease-in-out infinite; }
  @keyframes sk-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
  @keyframes sk-pulse { 50% { opacity: .35; } }
  @media (prefers-reduced-motion: reduce) { .sk-cell, .sk-row .dtr-grid-input, .source-pending .source-dot { animation: none; } }

  @media print {
    .no-print { display: none !important; }
    .dtr-scroll-wrapper {
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      background: white !important;
    }

    .dtr-container {
      margin: 0 auto !important;
      width: 8.5in !important;
      height: 11in !important;
      box-shadow: none !important;
      border: none !important;
      padding: 0.1in 0.4in !important;
    }

    .dtr-title {
      padding: 8px;
      font-size: 18px;
      border-width: 3px;
    }
    .dtr-info-grid {
      border-width: 3px;
    }
    .info-item {
      padding: 6px 12px;
      font-size: 11px;
      border-bottom-width: 2px;
    }

    .dtr-table {
      border-width: 3px;
      margin-top: -3px;
      flex-grow: 1;
    }
    .dtr-table th {
      padding: 4px;
      font-size: 10px;
      border-width: 2px;
    }
    .dtr-table td {
      padding: 2px 8px !important;
      height: 17px !important;
    }
    .dtr-grid-input {
      border: none !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
      color: black !important;
      height: auto !important;
      font-size: 10px !important;
    }
    .dtr-grid-input::placeholder {
      color: transparent !important;
    }

    .dtr-footer {
      margin-top: auto;
      padding-top: 15px;
      font-size: 11px;
    }
    .certification {
      margin-bottom: 10px;
      font-size: 12px;
    }
    .sig-lines {
      gap: 30px;
      margin-bottom: 10px;
    }
    .sig-underline {
      min-width: 140px;
      height: 16px;
      border-bottom: 2px solid #000;
    }
    .approval {
      margin-top: 15px;
      margin-bottom: 10px;
      font-size: 12px;
    }
  }

  @media (max-width: 900px) {
    .dtr-scroll-wrapper { padding: 20px 10px; }
  }
</style>
